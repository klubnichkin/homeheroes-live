---
import type { BrandAppliancePage } from '../../data/brandAppliances';
import { brandAppliances } from '../../data/brandAppliances';
import { getSymptom } from '../../data/symptoms';
import { getService } from '../../data/services';
import { cities } from '../../data/cities';
import { areas } from '../../data/areas';
import { business, businessGraph, servicePromise } from '../../data/business';
import { breadcrumbSchema, faqSchema, abs } from '../../lib/seo';
import SeoPageLayout from '../../layouts/SeoPageLayout.astro';
import SEOHero from './SEOHero.astro';
import QuickAnswer from './QuickAnswer.astro';
import LocalJobStats from './LocalJobStats.astro';
import FAQSection from './FAQSection.astro';
import InternalLinks from './InternalLinks.astro';
import NearbyLinks from './NearbyLinks.astro';
import SEOCTA from './SEOCTA.astro';
import StickyMobileCTA from '../cro/StickyMobileCTA.astro';
import InlineCTA from '../cro/InlineCTA.astro';

interface Props {
  page: BrandAppliancePage;
}
const { page } = Astro.props;

const path = `/charlotte-nc/${page.slug}`;
const canonical = abs(path);
const h1 = `${page.brand} ${page.appliance} Repair in Charlotte, NC`;
const nounLower = page.appliance.toLowerCase();
const service = getService(page.serviceSlug);

const quickAnswer = `We repair ${page.brand} ${nounLower}s across Charlotte and the surrounding towns. ${servicePromise}${
  page.codes.length ? ` Common ${page.brand} codes we fix include ${page.codes.slice(0, 3).map(c => c.code).join(', ')}.` : ''
}`;

const symptomLinks = page.symptomSlugs
  .map(s => getSymptom(s))
  .filter(Boolean)
  .map(s => ({ title: s!.symptomShort, href: `/charlotte-nc/${s!.slug}`, description: `${s!.appliance} symptom guide` }));

const siblingLinks = brandAppliances
  .filter(b => b.slug !== page.slug && (b.brand === page.brand || b.serviceSlug === page.serviceSlug))
  .slice(0, 8)
  .map(b => ({ title: `${b.brand} ${b.appliance} Repair`, href: `/charlotte-nc/${b.slug}` }));

const coverage = [
  ...(page.tier === 'premium' ? areas.filter(a => a.premium) : areas.slice(0, 6)).map(a => ({ name: a.name, href: `/charlotte-nc/areas/${a.slug}` })),
  ...cities.filter(c => c.slug !== 'charlotte-nc').map(c => ({ name: c.name, href: `/${c.slug}/${page.serviceSlug}` })),
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    ...businessGraph(),
    {
      '@type': 'Service',
      '@id': `${canonical}#service`,
      name: `${page.brand} ${page.appliance} Repair`,
      serviceType: `${page.appliance} repair`,
      brand: { '@type': 'Brand', name: page.brand },
      url: canonical,
      provider: { '@id': abs('/#business') },
      areaServed: { '@type': 'City', name: 'Charlotte', containedInPlace: { '@type': 'State', name: 'North Carolina' } },
    },
    faqSchema(page.faq),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Appliance Repair Charlotte', path: '/appliance-repair-charlotte' },
      { name: `${page.brand} Repair`, path: `/charlotte-nc/${page.brandSlug}` },
      { name: `${page.brand} ${page.appliance} Repair`, path },
    ]),
  ],
};
---

<SeoPageLayout title={page.seoTitle} description={page.metaDescription} canonical={canonical} schema={schema} ogImage={service?.imagePath} heroImage={service?.imagePath}>
  <SEOHero
    h1={h1}
    intro={page.intro}
    cityName="Charlotte, NC"
    phone={business.phone}
    phoneHref={business.phoneHref}
    breadcrumbs={[
      { label: 'Appliance Repair Charlotte', href: '/appliance-repair-charlotte' },
      { label: `${page.brand} Repair`, href: `/charlotte-nc/${page.brandSlug}` },
      { label: `${page.brand} ${page.appliance}`, href: '#' },
    ]}
    image={service?.imagePath}
    imageAlt={`${page.brand} ${nounLower} repair in Charlotte, NC`}
  />

  <QuickAnswer text={quickAnswer} />

  <section class="bg-white-section" style="padding:64px 24px">
    <div style="max-width:1100px;margin:0 auto" class="ba-two-col">
      <div>
        <div class="sec-label" style="margin-bottom:14px">Models We Repair</div>
        <h2 class="ba-h2">{page.brand} {page.appliance} Models We Service</h2>
        <ul class="ba-list">{page.lines.map(l => <li>{l}</li>)}</ul>
      </div>
      <div>
        <div class="sec-label" style="margin-bottom:14px">Warranty</div>
        <h2 class="ba-h2">Is It Still Under Warranty?</h2>
        <p class="ba-p">{page.warranty}</p>
      </div>
    </div>
  </section>

  {page.codes.length > 0 && (
    <section class="bg-pearl-section" style="padding:64px 24px">
      <div style="max-width:1100px;margin:0 auto">
        <div class="sec-label" style="margin-bottom:14px">Error Codes</div>
        <h2 class="ba-h2">{page.brand} {page.appliance} Error Codes and What They Mean</h2>
        <div class="ba-table-wrap">
          <table class="ba-table">
            <thead><tr><th>Code</th><th>Meaning</th><th>What usually fixes it</th></tr></thead>
            <tbody>
              {page.codes.map(c => (
                <tr><td class="ba-code">{c.code}</td><td>{c.meaning}</td><td>{c.fix}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="ba-note">Codes vary by model and display. If your code is not listed, call with the model number and we will tell you what it means.</p>
      </div>
    </section>
  )}

  <section class="bg-white-section" style="padding:64px 24px">
    <div style="max-width:1100px;margin:0 auto">
      <div class="sec-label" style="margin-bottom:14px">Common Failures</div>
      <h2 class="ba-h2">What Goes Wrong With {page.brand} {page.appliance}s</h2>
      <div class="ba-grid">
        {page.failures.map(f => (
          <div class="card" style="padding:24px">
            <h3 style="font-size:16px;font-weight:800;color:#060c19;margin:0 0 8px">{f.title}</h3>
            <p style="font-size:14.5px;color:#4a5568;line-height:1.7;margin:0">{f.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <LocalJobStats sliceKey={`brand:${page.brand.toLowerCase()}|service:${page.serviceSlug}`} subject={`${page.brand} ${nounLower}`} placeName="the Charlotte area" />

  <section class="bg-navy-section" style="padding:64px 24px">
    <div style="max-width:1100px;margin:0 auto" class="ba-two-col">
      <div>
        <div class="sec-label" style="margin-bottom:14px">Pricing</div>
        <h2 class="ba-h2" style="color:#fff">{page.brand} {page.appliance} Repair Cost in Charlotte</h2>
        <table class="ba-cost">
          <tbody>
            {page.costs.map(c => <tr><td>{c.repair}</td><td class="ba-cost-v">{c.range}</td></tr>)}
          </tbody>
        </table>
        <p style="font-size:13px;color:rgba(255,255,255,0.6);margin:14px 0 0">Ranges include parts and labor. Every repair is quoted before work starts.</p>
      </div>
      <div>
        <div class="sec-label" style="margin-bottom:14px">Repair or Replace</div>
        <h2 class="ba-h2" style="color:#fff">Is a {page.brand} {page.appliance} Worth Repairing?</h2>
        <p class="ba-p" style="color:rgba(255,255,255,0.8)">{page.repairOrReplace}</p>
      </div>
    </div>
  </section>

  <section class="bg-white-section" style="padding:0 24px">
    <div style="max-width:1200px;margin:0 auto">
      <InlineCTA phone={business.phone} phoneHref={business.phoneHref} variant="repair" />
    </div>
  </section>

  {symptomLinks.length > 0 && (
    <section class="bg-white-section" style="padding:56px 24px">
      <InternalLinks heading={`${page.appliance} Problems — Symptom Guides`} links={symptomLinks} />
    </section>
  )}

  <section class="bg-light-section" style="padding:56px 24px">
    <InternalLinks
      heading="Related Repairs"
      links={[
        { title: `All ${page.brand} Repair`, href: `/charlotte-nc/${page.brandSlug}` },
        ...(service ? [{ title: `${service.name} in Charlotte`, href: `/charlotte-nc/${service.slug}` }] : []),
        ...siblingLinks,
      ]}
    />
  </section>

  <FAQSection faqs={page.faq} heading={`${page.brand} ${page.appliance} Repair — FAQ`} />

  <NearbyLinks heading={`${page.brand} ${page.appliance} Repair Across the Charlotte Area`} links={coverage} />

  <SEOCTA phone={business.phone} phoneHref={business.phoneHref} />
  <StickyMobileCTA phone={business.phone} phoneHref={business.phoneHref} />
</SeoPageLayout>

<style>
  .ba-h2 { font-size: clamp(20px, 2.6vw, 30px); font-weight: 800; color: #060c19; margin: 0 0 18px; letter-spacing: -0.02em; }
  .ba-p { font-size: 15.5px; color: #374151; line-height: 1.75; margin: 0; }
  .ba-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: start; }
  .ba-list { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 15px; color: #374151; line-height: 1.6; }
  .ba-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; }
  .ba-table-wrap { overflow-x: auto; border-radius: 12px; border: 1px solid rgba(30,50,80,0.1); background: #fff; }
  .ba-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .ba-table th { text-align: left; background: #060c19; color: #fff; padding: 12px 16px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .ba-table td { padding: 12px 16px; border-top: 1px solid rgba(30,50,80,0.08); color: #374151; vertical-align: top; line-height: 1.55; }
  .ba-code { font-weight: 800; color: #b01616; white-space: nowrap; }
  .ba-note { font-size: 13px; color: #6b7280; margin: 12px 0 0; }
  .ba-cost { width: 100%; border-collapse: collapse; }
  .ba-cost td { padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.85); font-size: 15px; }
  .ba-cost-v { text-align: right; font-weight: 800; color: #fff; white-space: nowrap; }
  @media (max-width: 767px) { .ba-two-col { grid-template-columns: 1fr; gap: 32px; } }
</style>
