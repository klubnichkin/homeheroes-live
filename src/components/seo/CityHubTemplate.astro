---
import type { City } from '../../data/cities';
import { getCity } from '../../data/cities';
import { services, serviceMeta } from '../../data/services';
import { brands } from '../../data/brands';
import { business, businessGraph, servicePromise } from '../../data/business';
import { breadcrumbSchema, faqSchema, abs } from '../../lib/seo';
import SeoPageLayout from '../../layouts/SeoPageLayout.astro';
import QuickAnswer from './QuickAnswer.astro';
import LocalApplianceNotes from './LocalApplianceNotes.astro';
import LocalJobStats from './LocalJobStats.astro';
import CoverageDetails from './CoverageDetails.astro';
import NearbyLinks from './NearbyLinks.astro';
import FAQSection from './FAQSection.astro';
import InternalLinks from './InternalLinks.astro';
import SEOCTA from './SEOCTA.astro';
import StickyMobileCTA from '../cro/StickyMobileCTA.astro';

interface Props {
  city: City;
}
const { city } = Astro.props;

const canonical = abs(city.hubPath);
const title = `Appliance Repair ${city.name}, NC | Same-Day | HomeHeroes`;
const description = `Same-day appliance repair in ${city.displayName}: refrigerators, washers, dryers, dishwashers and ovens. $${business.diagnosticFee} diagnostic waived with repair. Call ${business.phone}.`;

const quickAnswer = `HomeHeroes repairs refrigerators, washers, dryers, dishwashers, ovens and other major appliances in ${city.displayName} (${city.zips.join(', ')}). ${servicePromise}`;

const serviceLinks = services.map(s => ({
  title: `${s.name} in ${city.name}`,
  href: `/${city.slug}/${s.slug}`,
  description: serviceMeta[s.slug]?.group === 'cold' ? 'Cooling, ice and water problems' : serviceMeta[s.slug]?.group === 'laundry' ? 'Draining, spinning and heating problems' : serviceMeta[s.slug]?.group === 'dish' ? 'Draining, leaking and cleaning problems' : 'Heating, ignition and control problems',
}));

const brandLinks = brands.map(b => ({ title: `${b.name} Repair`, href: `/charlotte-nc/${b.slug}`, description: b.priceRange }));

const nearby = city.nearby
  .map(slug => getCity(slug))
  .filter((c): c is City => Boolean(c))
  .map(c => ({ name: `Appliance repair in ${c.name}`, href: c.hubPath }));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    ...businessGraph(),
    {
      '@type': 'Service',
      '@id': `${canonical}#service`,
      name: `Appliance Repair in ${city.displayName}`,
      serviceType: 'Appliance repair',
      url: canonical,
      provider: { '@id': abs('/#business') },
      areaServed: {
        '@type': 'City',
        name: city.name,
        containedInPlace: { '@type': 'AdministrativeArea', name: `${city.county}, ${city.stateAbbr}` },
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: `Appliance repair services in ${city.name}`,
        itemListElement: services.map(s => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.name, url: abs(`/${city.slug}/${s.slug}`) },
        })),
      },
    },
    faqSchema(city.faq),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Appliance Repair Charlotte', path: '/appliance-repair-charlotte' },
      { name: `Appliance Repair ${city.name}`, path: city.hubPath },
    ]),
  ],
};
---

<SeoPageLayout title={title} description={description} canonical={canonical} schema={schema}>
  <section data-track-location="hero" style="background:#080f1e;padding:64px 24px 60px">
    <div style="max-width:960px;margin:0 auto">
      <nav aria-label="Breadcrumb" style="margin-bottom:20px">
        <ol style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:13px">
          <li><a href="/" style="color:rgba(255,255,255,0.5);text-decoration:none">Home</a></li>
          <li style="color:rgba(255,255,255,0.3)">›</li>
          <li><a href="/appliance-repair-charlotte" style="color:rgba(255,255,255,0.5);text-decoration:none">Appliance Repair Charlotte</a></li>
          <li style="color:rgba(255,255,255,0.3)">›</li>
          <li style="color:rgba(255,255,255,0.8)">{city.name}</li>
        </ol>
      </nav>
      <div style="font-size:0.72rem;font-weight:800;letter-spacing:0.18em;text-transform:uppercase;color:#dc2626;margin-bottom:14px">{city.areaType} · {city.county}</div>
      <h1 style="font-size:clamp(28px,4.5vw,52px);font-weight:900;color:#fff;margin:0 0 20px;line-height:1.1;letter-spacing:-0.03em">Appliance Repair in {city.displayName}</h1>
      {city.intro.map(p => (
        <p style="font-size:clamp(15px,1.8vw,17.5px);color:rgba(255,255,255,0.72);line-height:1.75;margin:0 0 16px;max-width:780px">{p}</p>
      ))}
      <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:22px">
        <a href={city.phoneHref} style="display:inline-flex;align-items:center;gap:9px;padding:14px 26px;background:linear-gradient(135deg,#b01616,#dc2626);color:#fff;font-weight:700;font-size:16px;border-radius:10px;text-decoration:none">
          Call {city.phone}
        </a>
        <a href="#contact-form" style="display:inline-flex;align-items:center;padding:14px 26px;border:2px solid rgba(255,255,255,0.2);color:#fff;font-weight:600;font-size:16px;border-radius:10px;text-decoration:none">
          Book Online
        </a>
      </div>
    </div>
  </section>

  <QuickAnswer text={quickAnswer} />

  <section id="all-services" class="bg-white-section" style="padding:64px 24px">
    <InternalLinks heading={`Appliance Repair Services in ${city.name}`} links={serviceLinks} />
  </section>

  <LocalApplianceNotes placeName={city.name} notes={city.applianceNotes} linkBase={`/${city.slug}`} />

  <LocalJobStats sliceKey={`city:${city.slug}`} subject="appliance" placeName={city.name} />

  <section class="bg-pearl-section" style="padding:64px 24px">
    <div style="max-width:1100px;margin:0 auto" class="hub-two-col">
      <div>
        <div class="sec-label" style="margin-bottom:14px">About {city.name}</div>
        <h2 style="font-size:clamp(20px,2.5vw,28px);font-weight:800;color:#060c19;margin:0 0 20px;letter-spacing:-0.02em">Serving {city.name} Homes &amp; Businesses</h2>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px">
          {city.localContext.map(fact => <li style="font-size:14.5px;color:#374151;line-height:1.65;padding-left:18px;position:relative"><span style="position:absolute;left:0;color:#b01616">•</span>{fact}</li>)}
        </ul>
      </div>
      <div>
        <div class="sec-label" style="margin-bottom:14px">Who We Help</div>
        <h2 style="font-size:clamp(20px,2.5vw,28px);font-weight:800;color:#060c19;margin:0 0 20px;letter-spacing:-0.02em">Customers in {city.name}</h2>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px">
          {city.customerTypes.map(ct => <li style="padding:12px 16px;background:#fff;border-radius:9px;border:1px solid rgba(30,50,80,0.08);font-size:14px;color:#374151;line-height:1.55">{ct}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <CoverageDetails placeName={city.name} zips={city.zips} neighborhoods={city.neighborhoods} landmarks={city.landmarks} housing={city.housing} utilities={city.utilities} />

  <section class="bg-light-section" style="padding:64px 24px">
    <InternalLinks heading={`Appliance Brands We Repair in ${city.name}`} links={brandLinks} />
  </section>

  <FAQSection faqs={city.faq} heading={`Appliance Repair in ${city.name} — FAQ`} />

  <NearbyLinks heading="Nearby Service Areas" links={nearby} />

  <SEOCTA phone={city.phone} phoneHref={city.phoneHref} />
  <StickyMobileCTA phone={city.phone} phoneHref={city.phoneHref} />
</SeoPageLayout>

<style>
  .hub-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
  @media (max-width: 767px) { .hub-two-col { grid-template-columns: 1fr; } }
</style>
