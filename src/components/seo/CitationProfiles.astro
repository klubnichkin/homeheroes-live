---
interface CitationCard {
  platform: string;
  platformColor: string;
  logoInitial: string;
  description: string;
  ctaText: string;
  href: string;
}

const citations: CitationCard[] = [
  {
    platform: 'Thumbtack',
    platformColor: '#009fd9',
    logoInitial: 'T',
    description: 'View our HomeHeroes service profile on Thumbtack.',
    ctaText: 'View HomeHeroes on Thumbtack',
    href: 'https://www.thumbtack.com/nc/charlotte/appliance-repair/home-heroes-services/service/583449664044261385',
  },
  // Future entries: Google Business Profile, Yelp, Angi, BBB, Nextdoor, Facebook, Houzz
];
---

<section aria-labelledby="citations-heading" class="bg-white-section" style="padding:72px 24px;border-top:1px solid rgba(30,50,80,0.08)">
  <div style="max-width:1200px;margin:0 auto">

    <div style="text-align:center;margin-bottom:48px">
      <div class="sec-label" style="margin-bottom:14px">Third-Party Profiles</div>
      <h2 id="citations-heading" style="font-size:clamp(22px,3vw,34px);font-weight:800;color:#060c19;margin:0 0 14px;letter-spacing:-0.02em">
        Trusted Across the Web
      </h2>
      <p style="font-size:16px;color:#4a5568;line-height:1.65;margin:0 auto;max-width:520px">
        See what homeowners are saying about HomeHeroes across trusted third-party platforms.
      </p>
    </div>

    <!-- Grid centers single card; expands naturally as more platforms are added -->
    <ul class="citations-grid">
      {citations.map((c) => (
        <li style="display:flex">
          <article
            class="card"
            style={`padding:28px;border-top:3px solid ${c.platformColor};display:flex;flex-direction:column;gap:16px;width:100%`}
          >
            <!-- Platform badge -->
            <div style="display:flex;align-items:center;gap:10px">
              <div
                aria-hidden="true"
                style={`width:36px;height:36px;border-radius:9px;background:${c.platformColor}18;border:1.5px solid ${c.platformColor}30;display:flex;align-items:center;justify-content:center;flex-shrink:0`}
              >
                <span style={`font-size:16px;font-weight:900;color:${c.platformColor};line-height:1`}>{c.logoInitial}</span>
              </div>
              <span style="font-size:15px;font-weight:800;color:#060c19;letter-spacing:-0.01em">{c.platform}</span>
              <!-- External profile label -->
              <span style="margin-left:auto;font-size:11px;font-weight:600;color:#6a7a8e;background:rgba(30,50,80,0.06);border:1px solid rgba(30,50,80,0.1);border-radius:100px;padding:2px 8px;white-space:nowrap">
                Profile
              </span>
            </div>

            <!-- Description -->
            <p style="font-size:14px;color:#2a3a50;line-height:1.7;margin:0;flex:1">
              {c.description}
            </p>

            <!-- CTA -->
            <a
              class="citation-link"
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${c.ctaText} — opens in a new tab`}
              style={`--platform-color:${c.platformColor}`}
            >
              {c.ctaText}
              <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
              </svg>
            </a>
          </article>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .citations-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 360px));
    gap: 20px;
    justify-content: center;
  }

  .citation-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border: 1.5px solid var(--platform-color);
    color: var(--platform-color);
    font-weight: 700;
    font-size: 13px;
    border-radius: 9px;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    align-self: flex-start;
  }

  .citation-link:hover {
    background: var(--platform-color);
    color: #fff;
  }

  .citation-link:focus-visible {
    outline: 3px solid var(--platform-color);
    outline-offset: 3px;
  }
</style>
