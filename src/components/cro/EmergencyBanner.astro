---
/**
 * EmergencyBanner — dismissible urgency strip at top of page.
 * Place inside <body> before the main hero, after <Header />.
 * Only shown server-side; JS handles dismiss/session-storage.
 */
interface Props {
  phone: string;
  phoneHref: string;
  message?: string;
}

const {
  phone,
  phoneHref,
  message = 'Same-day slots available today',
} = Astro.props;
---

<div id="emergency-banner" role="alert" aria-live="polite" style="background:linear-gradient(90deg,#8a0e0e,#b01616);padding:10px 16px;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;position:relative">

  <!-- Pulse dot -->
  <span aria-hidden="true" style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#ff6b6b;flex-shrink:0;animation:pulse-dot 1.8s ease-in-out infinite"></span>

  <p style="margin:0;font-size:13px;font-weight:600;color:#fff;line-height:1.3;text-align:center">
    {message} —&nbsp;
    <a href={phoneHref} style="color:#fff;text-decoration:underline;font-weight:700;white-space:nowrap" aria-label={`Call HomeHeroes emergency line at ${phone}`}>{phone}</a>
  </p>

  <a href={phoneHref} style="flex-shrink:0;display:inline-flex;align-items:center;gap:5px;padding:6px 14px;background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.35);color:#fff;font-weight:700;font-size:12px;border-radius:6px;text-decoration:none;white-space:nowrap" aria-label="Call now for same-day service">
    <svg width="13" height="13" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
    Call Now
  </a>

  <!-- Dismiss button -->
  <button id="emergency-banner-close" aria-label="Dismiss banner" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:rgba(255,255,255,0.6);padding:4px;line-height:1;font-size:16px">
    ✕
  </button>
</div>

<style>
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.75); }
  }
</style>

<script>
  (function () {
    const STORAGE_KEY = 'hh_banner_dismissed';
    const banner = document.getElementById('emergency-banner');
    const closeBtn = document.getElementById('emergency-banner-close');
    if (!banner || !closeBtn) return;

    // Hide if already dismissed in this session
    if (sessionStorage.getItem(STORAGE_KEY)) {
      banner.style.display = 'none';
      return;
    }

    closeBtn.addEventListener('click', () => {
      banner.style.display = 'none';
      try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch (_) {}
    });
  })();
</script>
