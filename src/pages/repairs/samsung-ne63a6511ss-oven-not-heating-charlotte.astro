  description="Samsung NE63A6511SS electric oven not heating in Charlotte. See the diagnosis, DG47-00071C bake element replacement, repair process and $443.17 total."
  canonical={canonical}
  schema={schema}
  ogImage="/images/repairs/samsung-ne63a6511ss-before.webp"
