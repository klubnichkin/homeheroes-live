const base = 'https://tryhomeheroes.com';
const canonical = `${base}/repairs/samsung-rf28t5001sr-not-cooling-ballantyne`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Samsung RF28T5001SR Not Cooling in Ballantyne, NC | Evaporator Fan Motor Repair",
  "description": "See how HomeHeroes repaired a Samsung RF28T5001SR refrigerator that stopped cooling in Ballantyne, NC. Includes diagnosis, evaporator fan motor replacement, parts cost, labor, and the $389.37 total.",
  "datePublished": "2026-10-19",
  "dateModified": "2026-10-19",
  "image": `${base}/images/repairs/samsung-rf28t5001sr-not-cooling-before.jpg`,
  "author": {
    "@type": "Organization",
    "name": "HomeHeroes Appliance Repair",
    "url": base
  },
  "publisher": {
    "@type": "LocalBusiness",
    "name": "HomeHeroes Appliance Repair",
    "@id": `${base}/#business`,
    "telephone": phone,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Charlotte",
      "addressRegion": "NC",
      "addressCountry": "US"
    }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
  "articleSection": "Appliance Repair Case Studies",
  "keywords": "Samsung RF28T5001SR not cooling, evaporator fan motor DA31-00334C, refrigerator repair Ballantyne Charlotte NC"
};
---

<SeoPageLayout
  title="Samsung RF28T5001SR Not Cooling in Ballantyne, NC | Fan Motor Repair"
  description="HomeHeroes repaired a Samsung RF28T5001SR that stopped cooling in Ballantyne, NC. Localized frost buildup, failed evaporator fan motor, same-day diagnosis and repair. Total: $389.37."
  canonical={canonical}
  schema={schema}
  ogImage="/images/repairs/samsung-rf28t5001sr-not-cooling-before.jpg"
  ogType="article"
  heroImage="/images/repairs/samsung-rf28t5001sr-not-cooling-before.jpg"
>

  <!-- ═══ HERO ═══ -->
  <section style="background:#080f1e;padding:56px 24px 52px;border-bottom:2px solid #7a0e0e">
    <div style="max-width:900px;margin:0 auto">

      <nav aria-label="Breadcrumb" style="margin-bottom:20px">
        <ol style="display:flex;align-items:center;gap:6px;list-style:none;margin:0;padding:0;flex-wrap:wrap">
          <li><a href="/" style="font-size:12px;color:rgba(255,255,255,0.4);text-decoration:none">Home</a></li>
          <li style="font-size:12px;color:rgba(255,255,255,0.2)" aria-hidden="true">›</li>
          <li><a href="/blog/recent-repairs" style="font-size:12px;color:rgba(255,255,255,0.4);text-decoration:none">Repair Cases</a></li>
          <li style="font-size:12px;color:rgba(255,255,255,0.2)" aria-hidden="true">›</li>
          <li style="font-size:12px;color:rgba(255,255,255,0.7)">Samsung RF28T5001SR</li>
        </ol>
      </nav>

      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px">
        <span style="font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;letter-spacing:0.06em;text-transform:uppercase;background:rgba(176,22,22,0.15);border:1px solid rgba(176,22,22,0.3);color:#dc2626">Samsung</span>
        <span style="font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;letter-spacing:0.06em;text-transform:uppercase;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7)">French-Door Refrigerator</span>
        <span style="font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;letter-spacing:0.06em;text-transform:uppercase;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7)">Ballantyne, Charlotte NC</span>
        <span style="font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;letter-spacing:0.06em;text-transform:uppercase;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7)">October 2026</span>
      </div>

      <h1 style="color:#fff;font-size:clamp(24px,3.5vw,40px);font-weight:900;line-height:1.15;margin:0 0 16px;letter-spacing:-0.03em">Samsung RF28T5001SR Not Cooling in Ballantyne, NC</h1>
      <p style="color:rgba(255,255,255,0.6);font-size:17px;line-height:1.6;margin:0 0 30px;max-width:700px">Refrigerator not cooling properly. Temperatures inconsistent. Evaporator fan motor confirmed failed. Diagnosed and repaired same day.</p>

      <div style="display:flex;flex-wrap:wrap;gap:10px">
        {[
          ['Repair Total', '$389.37'],
          ['Outcome', 'Cooling Restored'],
          ['Service', 'Same-Day'],
          ['Part', 'DA31-00334C'],
        ].map(([label, value]) => (
          <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:12px 18px;min-width:120px">
            <div style="font-size:0.6rem;font-weight:700;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px">{label}</div>
            <div style="font-size:0.95rem;font-weight:800;color:#e8edf5">{value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ MAIN CONTENT ═══ -->
  <div style="background:#f8f9fc;padding:52px 24px 80px">
    <div style="max-width:900px;margin:0 auto;display:flex;flex-direction:column;gap:28px">

      <!-- Opening paragraphs -->
      <div>
        <p style="font-size:1.02rem;color:#2a3c54;line-height:1.78;margin:0 0 16px">A homeowner in Ballantyne called us after their Samsung RF28T5001SR stopped cooling properly. The refrigerator was still running, the lights were on, and the unit did not look completely dead. But temperatures were becoming inconsistent and the refrigerator was no longer maintaining normal cooling performance.</p>
        <p style="font-size:1.02rem;color:#2a3c54;line-height:1.78;margin:0">During inspection, we found localized frost around the evaporator area and confirmed that the evaporator fan motor was not operating correctly. The repair was completed the same day using Samsung evaporator fan motor DA31-00334C.</p>
      </div>

      <!-- BEFORE PHOTO -->
      <figure style="margin:0;border-radius:14px;overflow:hidden;box-shadow:0 4px 28px rgba(6,12,25,0.1)">
        <img
          src="/images/repairs/samsung-rf28t5001sr-not-cooling-before.jpg"
          alt="Samsung RF28T5001SR refrigerator interior showing frost buildup around the rear airflow area during not-cooling diagnosis in Ballantyne NC"
          width="900"
          height="675"
          loading="eager"
          fetchpriority="high"
          style="width:100%;height:auto;display:block"
        />
        <figcaption style="font-size:0.78rem;color:#6a7a8e;line-height:1.55;padding:10px 16px;background:#f0f2f7;display:block">Before: localized frost was visible around the rear evaporator and airflow area during diagnosis. This restricted airflow and was contributing to the cooling problem on this unit.</figcaption>
      </figure>

      <!-- REPAIR SNAPSHOT -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;overflow:hidden">
        <div style="background:#060c19;color:#fff;font-size:0.68rem;font-weight:800;text-transform:uppercase;letter-spacing:0.14em;padding:12px 22px">Repair Snapshot</div>
        <div>
          {[
            ['Appliance',                'Samsung French-door refrigerator'],
            ['Model',                    'RF28T5001SR'],
            ['Location',                 'Ballantyne, Charlotte, NC'],
            ['Problem',                  'Refrigerator not cooling properly; inconsistent temperatures'],
            ['Root Cause',               'Failed evaporator fan motor with localized frost buildup restricting airflow'],
            ['Repair',                   'Defrost affected evaporator area and replace evaporator fan motor'],
            ['Part Used',                'Samsung DA31-00334C evaporator fan motor (OEM)'],
            ['OEM Part Price',           '$145.37'],
            ['Service Call / Diagnosis', '$89.00'],
            ['Labor',                    '$155.00'],
            ['Customer Total',           '$389.37'],
            ['Result',                   'Airflow and normal cooling restored'],
          ].map(([label, value], i) => (
            <div style={`display:grid;grid-template-columns:1fr 1.4fr;gap:8px;padding:11px 22px;border-bottom:1px solid rgba(30,50,80,0.05);background:${i % 2 === 1 ? 'rgba(248,249,252,0.6)' : 'transparent'}`}>
              <span style="font-size:0.79rem;font-weight:700;color:#6a7a8e">{label}</span>
              <span style="font-size:0.82rem;color:#1a2c44;font-weight:500">{value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- WHAT THE CUSTOMER WAS SEEING -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">👀</span>
          What the Customer Was Seeing
        </h2>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">The refrigerator was still running. Temperatures were becoming inconsistent and cooling performance had dropped. Nothing about the unit made it look completely dead. That is one of the more confusing patterns in refrigerator failures: the appliance appears to be working while something inside is not.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">Hearing the compressor run only tells us that the unit is attempting to cool. It does not prove that the sealed system is healthy, and it does not tell us whether cold air is moving correctly through the evaporator area. That requires diagnosis, not just listening.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 12px">Not cooling is a symptom, not a diagnosis. A refrigerator can stop cooling for several different reasons:</p>
        <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px">
          {[
            'Evaporator fan motor failure (this case)',
            'Frost buildup blocking the airflow path from the evaporator coil',
            'A defrost system failure allowing frost to accumulate over time',
            'A faulty thermistor or temperature sensor sending incorrect readings',
            'A control board issue disrupting the fan or defrost cycle',
            'A sealed system failure involving the compressor or refrigerant',
          ].map(item => (
            <li style="display:flex;align-items:flex-start;gap:10px;font-size:0.88rem;color:#2a3c54;line-height:1.6">
              <span style="color:#dc2626;font-weight:800;font-size:1rem;flex-shrink:0;margin-top:1px" aria-hidden="true">›</span>
              {item}
            </li>
          ))}
        </ul>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:16px 0 0">On this unit, the confirmed failure was the evaporator fan motor. That is why diagnosis matters before any part gets replaced. On another RF28T5001SR with the same symptom, the cause could be different.</p>
      </div>

      <!-- PULL QUOTE -->
      <blockquote style="margin:0;padding:22px 26px 22px 30px;background:rgba(176,22,22,0.04);border:1px solid rgba(176,22,22,0.15);border-left:4px solid #dc2626;border-radius:0 12px 12px 0;font-size:1.08rem;font-style:italic;font-weight:600;color:#1a2c44;line-height:1.5">
        "Not cooling does not automatically mean the compressor is dead."
      </blockquote>

      <!-- WHAT WE FOUND -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">🔍</span>
          What We Found
        </h2>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">During inspection, we found localized frost visible around the rear evaporator and upper airflow area. This was not a catastrophic freeze-over. It was targeted buildup in a specific location. That matters because even moderate frost in the right spot can restrict the airflow that the evaporator fan is responsible for moving.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">The evaporator fan on the RF28T5001SR is located in the freezer evaporator area, where it circulates cold air from the evaporator through the cooling system. When that motor is not running, airflow across the evaporator area is reduced or lost, and temperature problems follow.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0">The failed fan and localized frost buildup were both contributing to the airflow problem on this unit. Frost around an evaporator area can also come from defrost system failures, thermistor problems, drain restrictions, or other cooling-control issues. In this case, the fan motor was the confirmed failure. Clearing the frost and replacing the motor were both part of the repair.</p>
      </div>

      <!-- HOW WE DIAGNOSED IT -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">📋</span>
          How We Diagnosed It
        </h2>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">The first step was confirming the complaint. The customer reported poor and inconsistent cooling. We accessed the evaporator area, inspected the frost pattern, and checked fan operation directly.</p>
        <div style="margin:16px 0;padding:14px 20px;background:rgba(176,22,22,0.05);border-left:3px solid #dc2626;border-radius:0 8px 8px 0">
          <p style="font-size:0.88rem;color:#1a2c44;line-height:1.6;margin:0;font-style:italic;font-weight:600">The symptom tells us where to start. It does not tell us which part to replace.</p>
        </div>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">We pulled the rear panel and looked at the frost pattern. Localized frost around the evaporator area confirmed that airflow was compromised. We then tested the evaporator fan motor directly. It had failed.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">With the motor confirmed failed, the airflow problem explained the symptoms. Once the fan failure was confirmed and the cooling pattern matched that diagnosis, a sealed-system repair was not indicated in this case.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0">A running compressor alone does not rule out a sealed-system problem. The fan failure had to be confirmed independently, and it was.</p>
      </div>

      <!-- THE REPAIR -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">🔧</span>
          The Repair
        </h2>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 16px">Once the diagnosis was confirmed, the repair followed a straightforward sequence.</p>
        <div style="display:flex;flex-direction:column;gap:10px">
          {[
            ['1', 'Clear the affected area', 'The frost buildup around the evaporator cover was defrosted and cleared. This is necessary before accessing the fan motor and ensures a clean installation environment.'],
            ['2', 'Remove the failed motor', 'The defective evaporator fan motor was disconnected and removed from the evaporator assembly.'],
            ['3', 'Install OEM replacement', 'A genuine Samsung evaporator fan motor, part DA31-00334C, was installed in place of the failed unit.'],
            ['4', 'Restore and verify', 'The evaporator area was reassembled, the refrigerator was powered back up, and fan operation was confirmed. Temperatures were monitored as the refrigerator returned toward normal cooling.'],
          ].map(([num, step, detail]) => (
            <div style="display:flex;gap:14px;padding:14px 18px;background:#f8f9fc;border:1px solid rgba(30,50,80,0.07);border-radius:10px">
              <div style="width:26px;height:26px;border-radius:50%;background:rgba(176,22,22,0.1);border:1px solid rgba(176,22,22,0.2);color:#b01616;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px">{num}</div>
              <div>
                <div style="font-size:0.8rem;font-weight:800;color:#060c19;margin-bottom:3px">{step}</div>
                <div style="font-size:0.82rem;color:#4a5e74;line-height:1.58">{detail}</div>
              </div>
            </div>
          ))}
        </div>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:16px 0 0">Cooling was restored before we left. The customer's refrigerator was back in normal working order on the same visit.</p>
      </div>

      <!-- PART USED -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">🔩</span>
          Part Used in This Repair
        </h2>
        <h3 style="font-size:0.98rem;font-weight:700;color:#060c19;margin:0 0 10px">Samsung Evaporator Fan Motor DA31-00334C</h3>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">DA31-00334C is an evaporator fan motor used in the RF28T5001SR cooling system. On this model, repair documentation places the fan in the freezer evaporator area, where it circulates cold air from the evaporator through the freezer compartment.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 20px">When the motor fails, airflow across the evaporator area is reduced or lost. Temperature problems can develop even while the refrigerator still appears to be running normally.</p>

        <figure style="margin:0 0 16px;border-radius:10px;overflow:hidden;box-shadow:0 2px 16px rgba(6,12,25,0.08)">
          <img
            src="/images/repairs/samsung-da31-00334c-listing.jpg"
            alt="Samsung DA31-00334C evaporator fan motor OEM part listing showing price $145.37"
            width="860"
            height="430"
            loading="lazy"
            style="width:100%;height:auto;display:block"
          />
          <figcaption style="font-size:0.78rem;color:#6a7a8e;line-height:1.55;padding:9px 14px;background:#f0f2f7;display:block">OEM part reference shown for identification and price context. Retail pricing can change.</figcaption>
        </figure>

        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 6px">Retail reference price at the time of this repair: <strong>$145.37</strong></p>
        <p style="margin:0 0 20px"><a href="https://www.repairclinic.com/PartDetail/Evaporator-Fan-Motor/DA31-00334C/3589" rel="noopener noreferrer" target="_blank" style="font-size:0.8rem;color:#4a6a8a;text-decoration:underline">View OEM part reference</a></p>

        <figure style="margin:0;border-radius:10px;overflow:hidden;box-shadow:0 2px 16px rgba(6,12,25,0.08)">
          <img
            src="/images/repairs/samsung-da31-00334c-part.jpg"
            alt="Samsung DA31-00334C OEM evaporator fan motor used in the Ballantyne refrigerator repair"
            width="860"
            height="645"
            loading="lazy"
            style="width:100%;height:auto;display:block"
          />
          <figcaption style="font-size:0.78rem;color:#6a7a8e;line-height:1.55;padding:9px 14px;background:#f0f2f7;display:block">Samsung DA31-00334C evaporator fan motor. This is the actual OEM part used in the repair.</figcaption>
        </figure>
      </div>

      <!-- BEFORE AND AFTER -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 20px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">📸</span>
          Before and After
        </h2>
        <div class="photo-split" style="gap:16px">
          <figure style="margin:0">
            <div style="border-radius:10px;overflow:hidden;box-shadow:0 2px 16px rgba(6,12,25,0.08)">
              <img
                src="/images/repairs/samsung-rf28t5001sr-not-cooling-before.jpg"
                alt="Samsung RF28T5001SR refrigerator showing frost buildup before evaporator fan motor repair in Ballantyne NC"
                width="420"
                height="315"
                loading="lazy"
                style="width:100%;height:220px;object-fit:cover;display:block"
              />
            </div>
            <figcaption style="font-size:0.8rem;color:#4a5e74;line-height:1.5;padding:10px 4px 0;display:block"><strong>Before</strong> — Localized frost was visible around the rear upper airflow area during inspection. This restricted airflow and was contributing to the cooling problem.</figcaption>
          </figure>
          <figure style="margin:0">
            <div style="border-radius:10px;overflow:hidden;box-shadow:0 2px 16px rgba(6,12,25,0.08)">
              <img
                src="/images/repairs/samsung-rf28t5001sr-not-cooling-after.jpg"
                alt="Samsung RF28T5001SR refrigerator interior after evaporator fan motor repair in Ballantyne NC"
                width="420"
                height="315"
                loading="lazy"
                style="width:100%;height:220px;object-fit:cover;display:block"
              />
            </div>
            <figcaption style="font-size:0.8rem;color:#4a5e74;line-height:1.5;padding:10px 4px 0;display:block"><strong>After</strong> — After the affected area was cleared and the fan repair completed, the interior was returned to normal operating condition.</figcaption>
          </figure>
        </div>
      </div>

      <!-- COST BREAKDOWN -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 20px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">💰</span>
          Cost Breakdown
        </h2>
        <div style="background:#f8f9fc;border:1px solid rgba(30,50,80,0.08);border-radius:12px;overflow:hidden;margin-bottom:16px">
          {[
            ['Service call / diagnosis', '$89.00'],
            ['OEM evaporator fan motor (DA31-00334C)', '$145.37'],
            ['Labor', '$155.00'],
          ].map(([label, amount]) => (
            <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 20px;border-bottom:1px solid rgba(30,50,80,0.06);background:#fff">
              <span style="font-size:0.85rem;color:#1a2c44;font-weight:500">{label}</span>
              <span style="font-size:0.92rem;font-weight:800;color:#060c19;white-space:nowrap;margin-left:16px">{amount}</span>
            </div>
          ))}
          <div style="display:flex;justify-content:space-between;align-items:center;padding:16px 20px;background:rgba(6,12,25,0.03)">
            <span style="font-size:0.88rem;font-weight:800;color:#060c19;text-transform:uppercase;letter-spacing:0.04em">Customer Total</span>
            <span style="font-size:1.25rem;font-weight:900;color:#b01616">$389.37</span>
          </div>
        </div>
        <p style="font-size:0.86rem;color:#4a5e74;line-height:1.65;padding:14px 18px;background:#f8f9fc;border:1px solid rgba(30,50,80,0.07);border-radius:10px;margin:0 0 10px">For a Samsung French-door refrigerator in otherwise good condition, $389.37 is a straightforward value decision. The confirmed failure was a mechanical component in the cooling system. The repair was fully resolved in a single visit.</p>
        <p style="font-size:0.84rem;color:#6a7a8e;line-height:1.65;padding:12px 16px;background:#f0f2f7;border:1px solid rgba(30,50,80,0.07);border-radius:10px;margin:0">This was the total for this specific repair. Another RF28T5001SR with a "not cooling" complaint can require a completely different repair depending on the actual failure.</p>
      </div>

      <!-- COULD THE SAME SYMPTOM MEAN SOMETHING ELSE -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">❓</span>
          Could the Same Symptom Mean Something Else?
        </h2>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">Yes. A refrigerator that is not cooling can fail for several different reasons, and the right repair depends entirely on which one applies.</p>
        <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;margin-bottom:16px">
          {[
            'The evaporator fan motor stopped running (this case)',
            'Frost buildup is physically blocking the airflow path',
            'A defrost heater or defrost thermostat failure let frost accumulate over weeks',
            'A thermistor is sending incorrect temperature data to the control board',
            'A control board issue is disrupting the fan cycle or defrost cycle',
            'A sealed system failure affecting the compressor, condenser, or refrigerant charge',
          ].map(item => (
            <li style="display:flex;align-items:flex-start;gap:10px;font-size:0.88rem;color:#2a3c54;line-height:1.6">
              <span style="color:#dc2626;font-weight:800;font-size:1rem;flex-shrink:0;margin-top:1px" aria-hidden="true">›</span>
              {item}
            </li>
          ))}
        </ul>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">The point of proper diagnosis is to figure out which of those applies to this specific refrigerator on this visit. Replacing parts based on the symptom alone is how customers end up paying for the wrong repair.</p>
        <p style="font-size:0.83rem;color:#6a7a8e;line-height:1.65;padding:12px 16px;background:#f0f2f7;border:1px solid rgba(30,50,80,0.07);border-radius:10px;margin:0">Repair notes on this page are based on this specific RF28T5001SR service call. The same symptom on another refrigerator can have a different cause and should be diagnosed before parts are replaced.</p>
      </div>

      <!-- WAS IT WORTH REPAIRING -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">✅</span>
