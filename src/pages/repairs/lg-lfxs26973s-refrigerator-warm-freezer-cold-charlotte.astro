---
import SeoPageLayout from '../../layouts/SeoPageLayout.astro';
import StickyMobileCTA from '../../components/cro/StickyMobileCTA.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { phone, phoneHref } from '../../data/siteData';

const base = 'https://tryhomeheroes.com';
const canonical = `${base}/repairs/lg-lfxs26973s-refrigerator-warm-freezer-cold-charlotte`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "LG LFXS26973S Refrigerator Warm but Freezer Cold in Charlotte, NC | Evaporator Fan EAU63923603",
  "description": "See how HomeHeroes diagnosed an LG LFXS26973S refrigerator with a warm fresh-food section and cold freezer in Charlotte, including evaporator fan EAU63923603, repair cost and testing.",
  "datePublished": "2026-10-24",
  "dateModified": "2026-10-24",
  "image": `${base}/images/repairs/lg-lfxs26973s-before.webp`,
  "author": {
    "@type": "Organization",
    "name": "HomeHeroes Appliance Repair",
    "url": base
  },
  "publisher": {
    "@type": "LocalBusiness",
    "name": "HomeHeroes Appliance Repair",
    "@id": `${base}/#business`,
    "telephone": phone,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Charlotte",
      "addressRegion": "NC",
      "addressCountry": "US"
    }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
  "articleSection": "Appliance Repair Case Studies",
  "keywords": "LG LFXS26973S refrigerator warm freezer cold, LG LFXS26973S not cooling, LFXS26973S evaporator fan, EAU63923603, LG evaporator fan replacement, LG refrigerator airflow, LG refrigerator repair Charlotte NC"
};
---

<SeoPageLayout
  title="LG LFXS26973S Refrigerator Warm but Freezer Cold in Charlotte, NC | HomeHeroes"
  description="See how HomeHeroes diagnosed an LG LFXS26973S refrigerator with a warm fresh-food section and cold freezer in Charlotte, including evaporator fan EAU63923603, repair cost and testing. Total: $367.69."
  canonical={canonical}
  schema={schema}
  ogImage="/images/repairs/lg-lfxs26973s-before.webp"
  ogType="article"
  heroImage="/images/repairs/lg-lfxs26973s-before.webp"
>

  <!-- HERO -->
  <section style="background:#080f1e;padding:56px 24px 52px;border-bottom:2px solid #7a0e0e">
    <div style="max-width:900px;margin:0 auto">

      <nav aria-label="Breadcrumb" style="margin-bottom:20px">
        <ol style="display:flex;align-items:center;gap:6px;list-style:none;margin:0;padding:0;flex-wrap:wrap">
          <li><a href="/" style="font-size:12px;color:rgba(255,255,255,0.4);text-decoration:none">Home</a></li>
          <li style="font-size:12px;color:rgba(255,255,255,0.2)" aria-hidden="true">›</li>
          <li><a href="/blog/recent-repairs" style="font-size:12px;color:rgba(255,255,255,0.4);text-decoration:none">Repair Cases</a></li>
          <li style="font-size:12px;color:rgba(255,255,255,0.2)" aria-hidden="true">›</li>
          <li style="font-size:12px;color:rgba(255,255,255,0.7)">LG LFXS26973S</li>
        </ol>
      </nav>

      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px">
        <span style="font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;letter-spacing:0.06em;text-transform:uppercase;background:rgba(176,22,22,0.15);border:1px solid rgba(176,22,22,0.3);color:#dc2626">LG</span>
        <span style="font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;letter-spacing:0.06em;text-transform:uppercase;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7)">French-Door Refrigerator</span>
        <span style="font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;letter-spacing:0.06em;text-transform:uppercase;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7)">Charlotte, NC</span>
        <span style="font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;letter-spacing:0.06em;text-transform:uppercase;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7)">October 2026</span>
      </div>

      <h1 style="color:#fff;font-size:clamp(24px,3.5vw,40px);font-weight:900;line-height:1.15;margin:0 0 16px;letter-spacing:-0.03em">LG LFXS26973S Refrigerator Warm but Freezer Still Cold in Charlotte, NC</h1>
      <p style="color:rgba(255,255,255,0.6);font-size:17px;line-height:1.6;margin:0 0 30px;max-width:700px">Frozen food stayed frozen. Ice stayed solid. The fresh-food section was warming up. Failed refrigerator evaporator fan motor diagnosed and replaced same day.</p>

      <div style="display:flex;flex-wrap:wrap;gap:10px">
        {[
          ['Repair Total', '$367.69'],
          ['Outcome', 'Airflow Restored'],
          ['Service', 'Same-Day'],
          ['Part', 'EAU63923603'],
        ].map(([label, value]) => (
          <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:12px 18px;min-width:120px">
            <div style="font-size:0.6rem;font-weight:700;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px">{label}</div>
            <div style="font-size:0.95rem;font-weight:800;color:#e8edf5">{value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <div style="background:#f8f9fc;padding:52px 24px 80px">
    <div style="max-width:900px;margin:0 auto;display:flex;flex-direction:column;gap:28px">

      <!-- Opening -->
      <div>
        <p style="font-size:1.02rem;color:#2a3c54;line-height:1.78;margin:0 0 16px">The freezer still felt cold. Frozen food stayed frozen. Ice was still solid. But the refrigerator compartment was getting warmer. This LG LFXS26973S/02 French-door refrigerator still had cooling capacity -- but it was no longer moving enough cold air through the fresh-food section.</p>
        <p style="font-size:1.02rem;color:#2a3c54;line-height:1.78;margin:0">A cold freezer does not guarantee a cold refrigerator. The two compartments depend on controlled airflow, and that airflow has its own components that can fail. This repair scenario isolated the refrigerator evaporator fan motor as the failed part.</p>
      </div>

      <!-- BEFORE PHOTO (LCP) -->
      <figure style="margin:0;border-radius:14px;overflow:hidden;box-shadow:0 4px 28px rgba(6,12,25,0.1)">
        <img
          src="/images/repairs/lg-lfxs26973s-before.webp"
          alt="LG LFXS26973S refrigerator before repair in Charlotte NC"
          width="900"
          height="675"
          loading="eager"
          fetchpriority="high"
          style="width:100%;height:auto;display:block"
        />
        <figcaption style="font-size:0.78rem;color:#6a7a8e;line-height:1.55;padding:10px 16px;background:#f0f2f7;display:block">LG LFXS26973S/02 French-door refrigerator before airflow diagnosis. The unit was cooling the freezer normally while the fresh-food section warmed.</figcaption>
      </figure>

      <!-- REPAIR SNAPSHOT -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;overflow:hidden">
        <div style="background:#060c19;color:#fff;font-size:0.68rem;font-weight:800;text-transform:uppercase;letter-spacing:0.14em;padding:12px 22px">Repair Snapshot</div>
        <div>
          {[
            ['Appliance',                'LG French-door refrigerator'],
            ['Model',                    'LFXS26973S/02'],
            ['Location',                 'Charlotte, NC'],
            ['Customer Complaint',       'Refrigerator section warm while freezer remains cold'],
            ['Diagnosis',                'Failed refrigerator evaporator fan motor'],
            ['Repair',                   'Access airflow system, replace evaporator fan motor, reassemble and verify fan operation'],
            ['Part Used',                'EAU63923603 evaporator fan motor'],
            ['Part Reference Price',     '$103.69'],
            ['Service Call / Diagnosis', '$89.00'],
            ['Labor',                    '$175.00'],
            ['Customer Total',           '$367.69'],
            ['Result',                   'Refrigerator airflow restored after repair and testing'],
          ].map(([label, value], i) => (
            <div style={`display:grid;grid-template-columns:1fr 1.4fr;gap:8px;padding:11px 22px;border-bottom:1px solid rgba(30,50,80,0.05);background:${i % 2 === 1 ? 'rgba(248,249,252,0.6)' : 'transparent'}`}>
              <span style="font-size:0.79rem;font-weight:700;color:#6a7a8e">{label}</span>
              <span style="font-size:0.82rem;color:#1a2c44;font-weight:500">{value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- WHAT THE CUSTOMER WAS SEEING -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">👀</span>
          What the Customer Was Seeing
        </h2>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">The freezer was working. Frozen food stayed frozen. Ice remained solid. The compressor was still running. But when you opened the refrigerator doors, the section did not feel cold the way it should. Fresh food and drinks were not staying at safe temperatures. The airflow from the vents felt weak or absent.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0">The refrigerator still had cooling. The problem was getting that cooling where it needed to go.</p>

        <!-- WARM FRIDGE PHOTO -->
        <figure style="margin:18px 0 0;border-radius:10px;overflow:hidden;box-shadow:0 2px 16px rgba(6,12,25,0.08)">
          <img
            src="/images/repairs/lg-lfxs26973s-warm-fridge.webp"
            alt="LG LFXS26973S refrigerator warm while freezer cold"
            width="860"
            height="645"
            loading="lazy"
            style="width:100%;height:auto;display:block"
          />
          <figcaption style="font-size:0.78rem;color:#6a7a8e;line-height:1.55;padding:9px 14px;background:#f0f2f7;display:block">The fresh-food section was warming even though the freezer still retained cooling. The refrigerator appeared to be working normally from the outside.</figcaption>
        </figure>
      </div>

      <!-- PULL QUOTE -->
      <blockquote style="margin:0;padding:22px 26px 22px 30px;background:rgba(176,22,22,0.04);border:1px solid rgba(176,22,22,0.15);border-left:4px solid #dc2626;border-radius:0 12px 12px 0;font-size:1.08rem;font-style:italic;font-weight:600;color:#1a2c44;line-height:1.5">
        "A cold freezer does not guarantee a cold refrigerator."
      </blockquote>

      <!-- WHY THIS SYMPTOM IS DECEPTIVE -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">💡</span>
          Why "Warm Refrigerator, Cold Freezer" Is a Deceptive Symptom
        </h2>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">The freezer and refrigerator sections are not fully independent systems. They share a cooling source, but they depend on controlled airflow to distribute that cold to each section. When something disrupts airflow into the refrigerator, that section can warm up even while the freezer stays cold.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 12px">Possible causes for this symptom pattern include:</p>
        <ul style="margin:0 0 16px;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px">
          {[
            'Blocked or restricted air vents',
            'Excessive frost build-up restricting airflow',
            'Evaporator fan failure (this case)',
            'Defrost-system problem leading to frost restriction',
            'Temperature sensor or control issue',
            'Door seal problem allowing warm air in',
            'Overpacking blocking internal airflow',
          ].map(item => (
            <li style="display:flex;align-items:flex-start;gap:10px;font-size:0.88rem;color:#2a3c54;line-height:1.6">
              <span style="color:#dc2626;font-weight:800;font-size:1rem;flex-shrink:0;margin-top:1px" aria-hidden="true">›</span>
              {item}
            </li>
          ))}
        </ul>
        <div style="padding:14px 20px;background:rgba(176,22,22,0.05);border-left:3px solid #dc2626;border-radius:0 8px 8px 0">
          <p style="font-size:0.88rem;color:#1a2c44;line-height:1.6;margin:0;font-style:italic;font-weight:600">The symptom tells us to investigate airflow. It does not tell us which part failed.</p>
        </div>
      </div>

      <!-- WARM FRIDGE DOES NOT AUTOMATICALLY MEAN BAD FAN -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">🔍</span>
          Warm Refrigerator + Cold Freezer Does Not Mean the Fan Is Bad
        </h2>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">Before any component is replaced, basic airflow conditions should be checked. An overpacked refrigerator can block vents and warm the fresh-food section without any part failing. A door that is not sealing properly lets warm air in continuously. Frost restriction from a defrost-system problem can block airflow entirely and look identical to a fan failure from the outside.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0">Not every warm refrigerator with a cold freezer needs a fan motor. The symptom identifies the system to investigate. Diagnosis identifies the failed component.</p>
      </div>

      <!-- WHAT WE FOUND -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">📋</span>
          What We Found on This LFXS26973S
        </h2>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">The freezer still had cooling capacity, but airflow into the refrigerator section was not normal. After the obvious airflow restrictions and operating conditions were checked, diagnosis isolated the refrigerator evaporator fan motor as the failed component.</p>

        <!-- EVAPORATOR ACCESS PHOTO -->
        <figure style="margin:18px 0 0;border-radius:10px;overflow:hidden;box-shadow:0 2px 16px rgba(6,12,25,0.08)">
          <img
            src="/images/repairs/lg-lfxs26973s-evaporator-access.webp"
            alt="LG LFXS26973S evaporator fan access during refrigerator repair"
            width="860"
            height="645"
            loading="lazy"
            style="width:100%;height:auto;display:block"
          />
          <figcaption style="font-size:0.78rem;color:#6a7a8e;line-height:1.55;padding:9px 14px;background:#f0f2f7;display:block">Evaporator airflow area accessed during professional diagnosis of the LG LFXS26973S refrigerator.</figcaption>
        </figure>
      </div>

      <!-- THE PART -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">🔩</span>
          LG LFXS26973S Evaporator Fan Motor: EAU63923603
        </h2>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">EAU63923603 is the refrigerator evaporator fan motor used in this repair. Its job is to move cold air through the refrigerator airflow system -- pulling air over the evaporator coils and circulating it through the fresh-food section.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 14px">It is worth being clear about what the fan does and does not do. The cooling system makes cold. The fan moves it. The evaporator fan does not create refrigeration -- it distributes the cold air that the sealed system produces. A failed fan motor stops circulation without stopping cooling, which is exactly why the freezer can stay cold while the refrigerator warms.</p>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 20px">Reference part price at the time of this repair: <strong>$103.69</strong>. Retail pricing can change by supplier and availability.</p>

        <!-- OLD FAN PHOTO -->
        <figure style="margin:0 0 16px;border-radius:10px;overflow:hidden;box-shadow:0 2px 16px rgba(6,12,25,0.08)">
          <img
            src="/images/repairs/lg-lfxs26973s-old-fan.webp"
            alt="LG EAU63923603 evaporator fan motor removed from LFXS26973S"
            width="860"
            height="645"
            loading="lazy"
            style="width:100%;height:auto;display:block"
          />
          <figcaption style="font-size:0.78rem;color:#6a7a8e;line-height:1.55;padding:9px 14px;background:#f0f2f7;display:block">Removed evaporator fan motor from this LFXS26973S repair scenario.</figcaption>
        </figure>

        <!-- NEW FAN PHOTO -->
        <figure style="margin:0;border-radius:10px;overflow:hidden;box-shadow:0 2px 16px rgba(6,12,25,0.08)">
          <img
            src="/images/repairs/lg-lfxs26973s-new-fan.webp"
            alt="LG EAU63923603 replacement evaporator fan motor"
            width="860"
            height="645"
            loading="lazy"
            style="width:100%;height:auto;display:block"
          />
          <figcaption style="font-size:0.78rem;color:#6a7a8e;line-height:1.55;padding:9px 14px;background:#f0f2f7;display:block">Replacement EAU63923603 evaporator fan motor before installation.</figcaption>
        </figure>
      </div>

      <!-- PULL QUOTE 2 -->
      <blockquote style="margin:0;padding:22px 26px 22px 30px;background:rgba(176,22,22,0.04);border:1px solid rgba(176,22,22,0.15);border-left:4px solid #dc2626;border-radius:0 12px 12px 0;font-size:1.08rem;font-style:italic;font-weight:600;color:#1a2c44;line-height:1.5">
        "The cooling system makes cold. The fan moves it."
      </blockquote>

      <!-- EVAPORATOR FAN VS CONDENSER FAN -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">⚡</span>
          Evaporator Fan vs. Condenser Fan
        </h2>
        <p style="font-size:0.92rem;color:#2a3c54;line-height:1.73;margin:0 0 16px">Same refrigerator. Two very different fans.</p>
        <div style="display:flex;flex-direction:column;gap:10px">
          {[
            ['Evaporator fan (this repair)', 'Located inside the refrigerator/freezer section. Moves cold air through the airflow system to circulate cooling through both compartments. This is EAU63923603 -- the part replaced in this case.'],
            ['Condenser fan', 'Located near the compressor, typically at the bottom rear of the refrigerator. Moves air across the condenser and compressor area to dissipate heat. A separate motor and a separate failure mode.'],
          ].map(([title, detail]) => (
            <div style="display:flex;gap:14px;padding:14px 18px;background:#f8f9fc;border:1px solid rgba(30,50,80,0.07);border-radius:10px">
              <div style="width:8px;height:8px;border-radius:50%;background:#b01616;flex-shrink:0;margin-top:5px"></div>
              <div>
                <div style="font-size:0.8rem;font-weight:800;color:#060c19;margin-bottom:3px">{title}</div>
                <div style="font-size:0.82rem;color:#4a5e74;line-height:1.58">{detail}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- THE REPAIR -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:1.12rem;font-weight:800;color:#060c19;margin:0 0 16px;letter-spacing:-0.01em">
          <span style="font-size:1.25rem" aria-hidden="true">🔧</span>
          The Repair
        </h2>
        <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px">
          {[
            ['1', 'Confirm the warm-refrigerator / cold-freezer complaint', 'Verify the symptom and rule out obvious operating conditions.'],
            ['2', 'Check temperature settings and airflow restrictions', 'Confirm settings are correct. Check for blocking, overpacking, or frost restriction.'],
            ['3', 'Inspect refrigerator airflow', 'Evaluate vent condition and air circulation through the fresh-food section.'],
            ['4', 'Access evaporator fan area', 'Remove rear panel or access panel to reach the fan motor assembly.'],
            ['5', 'Diagnose fan operation', 'Confirm fan motor failure as the source of the airflow problem.'],
            ['6', 'Remove failed fan motor', 'Disconnect and extract the original EAU63923603-compatible motor.'],
            ['7', 'Install replacement EAU63923603', 'Fit and connect the replacement fan motor.'],
            ['8', 'Reassemble airflow components', 'Reinstall panels and restore the compartment to operating condition.'],
            ['9', 'Restore power', 'Return unit to normal operation.'],
            ['10', 'Verify fan operation and airflow', 'Confirm fan is running and cold air is circulating through the refrigerator section.'],
          ].map(([num, step, detail]) => (
            <div style="display:flex;gap:14px;padding:14px 18px;background:#f8f9fc;border:1px solid rgba(30,50,80,0.07);border-radius:10px">
              <div style="width:26px;height:26px;border-radius:50%;background:rgba(176,22,22,0.1);border:1px solid rgba(176,22,22,0.2);color:#b01616;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px">{num}</div>
              <div>
                <div style="font-size:0.8rem;font-weight:800;color:#060c19;margin-bottom:3px">{step}</div>
                <div style="font-size:0.82rem;color:#4a5e74;line-height:1.58">{detail}</div>
              </div>
            </div>
          ))}
        </div>

        <!-- FAN INSTALLATION PHOTO -->
        <figure style="margin:0 0 16px;border-radius:10px;overflow:hidden;box-shadow:0 2px 16px rgba(6,12,25,0.08)">
          <img
            src="/images/repairs/lg-lfxs26973s-fan-installation.webp"
            alt="LG LFXS26973S evaporator fan replacement in Charlotte NC"
            width="860"
            height="645"
            loading="lazy"
            style="width:100%;height:auto;display:block"
          />
          <figcaption style="font-size:0.78rem;color:#6a7a8e;line-height:1.55;padding:9px 14px;background:#f0f2f7;display:block">Replacement fan motor installed in the airflow assembly.</figcaption>
        </figure>

        <!-- AFTER PHOTO -->
        <figure style="margin:0;border-radius:10px;overflow:hidden;box-shadow:0 2px 16px rgba(6,12,25,0.08)">
          <img
            src="/images/repairs/lg-lfxs26973s-after.webp"
            alt="LG LFXS26973S refrigerator after evaporator fan repair"
            width="860"
            height="645"
            loading="lazy"
            style="width:100%;height:auto;display:block"
          />
          <figcaption style="font-size:0.78rem;color:#6a7a8e;line-height:1.55;padding:9px 14px;background:#f0f2f7;display:block">Refrigerator reassembled after fan operation and airflow verification.</figcaption>
        </figure>
      </div>

      <!-- COST BREAKDOWN -->
      <div style="background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:14px;padding:26px 28px">
