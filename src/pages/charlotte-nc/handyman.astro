    <section id="contact" style="position:relative;overflow:hidden;padding:80px 24px 96px;background:linear-gradient(135deg,#c92020 0%,#8a0e0e 55%,#520808 100%)">
      <div style="position:absolute;inset:0;opacity:0.045;background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2250%22 height=%2250%22%3E%3Cpath d=%22M0 0h50v50H0z%22 fill=%22none%22/%3E%3Cpath d=%22M0 0L50 0M0 50L50 50M0 0L0 50M50 0L50 50%22 stroke=%22white%22 stroke-width=%221%22/%3E%3C/svg%3E')" aria-hidden="true"></div>
      <div style="max-width:940px;margin:0 auto;position:relative;text-align:center">
        <img src="/images/logo.webp" alt="HomeHeroes" width="70" height="70" loading="lazy"
             style="border-radius:16px;object-fit:cover;margin:0 auto 22px;display:block;box-shadow:0 6px 24px rgba(6,12,25,0.38),0 0 0 2px rgba(255,255,255,0.18)" />
        <h2 style="font-size:clamp(2rem,5vw,3.5rem);font-weight:900;color:#fff;letter-spacing:-0.04em;line-height:1.04;margin:0 0 18px">
          Home Repair List?<br />We'll Handle It Today.
        </h2>
        <p style="font-size:1.05rem;color:rgba(255,220,220,0.82);line-height:1.74;margin:0 auto 44px;max-width:460px;font-weight:400">
          Same-day handyman service across Charlotte. Batch your repairs — one visit, one service call. Call now or book online.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center">
          <a href="#contact-form" style="display:inline-flex;align-items:center;justify-content:center;gap:9px;font-weight:800;font-size:1rem;color:#8a0e0e;padding:15px 34px;border-radius:10px;text-decoration:none;background:#fff;box-shadow:0 6px 24px rgba(6,12,25,0.26);transition:transform 0.15s"
             onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='none'">
            Book Handyman Service
          </a>
          <a href={phoneHref} style="display:inline-flex;align-items:center;justify-content:center;gap:9px;font-weight:800;font-size:1rem;color:#fff;padding:15px 34px;border-radius:10px;text-decoration:none;border:2px solid rgba(255,255,255,0.3);background:rgba(255,255,255,0.1);transition:transform 0.15s"
             onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='none'">
            <svg width="17" height="17" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
            Call {phone}
          </a>
        </div>
      </div>
    </section>

    <!-- Contact form -->
    <section id="contact-form" class="bg-white-section" style="padding:64px 24px 80px">
      <div style="max-width:680px;margin:0 auto">
        <div style="text-align:center;margin-bottom:36px">
          <div class="sec-label" style="justify-content:center;margin-bottom:12px">Book a Handyman</div>
          <h2 style="font-size:clamp(1.5rem,2.8vw,2.1rem);font-weight:900;color:#060c19;letter-spacing:-0.03em;margin:0 0 10px">Request Same-Day Service</h2>
          <p style="font-size:0.88rem;color:#4a5e74;margin:0">We'll call you back within minutes to confirm your appointment.</p>
        </div>

        <div style="background:#fff;border:1.5px solid rgba(30,50,80,0.1);border-radius:18px;overflow:hidden;box-shadow:0 12px 40px rgba(10,20,40,0.08)">
          <div style="padding:20px 32px;background:linear-gradient(135deg,#060c19,#0a1628);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
            <div>
              <div style="font-size:0.93rem;font-weight:800;color:#fff">HomeHeroes Handyman</div>
              <div style="font-size:0.72rem;color:#4a7a9e;margin-top:2px;font-weight:500">Charlotte, NC · Same-day available</div>
            </div>
            <div style="display:flex;align-items:center;gap:7px">
              <span style="width:8px;height:8px;border-radius:50%;background:#34d399;animation:pulse 2s infinite;flex-shrink:0"></span>
              <span style="font-size:0.72rem;font-weight:700;color:#34d399">Taking Appointments Now</span>
            </div>
          </div>

          <form id="handyman-form" style="padding:24px 32px;display:flex;flex-direction:column;gap:16px" name="handyman-request" method="POST" action="https://api.web3forms.com/submit">
            <input type="hidden" name="access_key" value="98673c2a-0528-45c5-a5d0-2561df9d62fb" />
            <input type="hidden" name="subject" value="New HomeHeroes Handyman Service Request" />

            <div class="form-row">
              <div>
                <label for="hy-name" style="display:block;font-size:0.72rem;font-weight:800;color:#060c19;margin-bottom:5px;letter-spacing:0.06em">FIRST NAME</label>
                <input type="text" id="hy-name" name="first_name" autocomplete="given-name" required placeholder="John"
                       style="width:100%;padding:11px 14px;border-radius:9px;border:1.5px solid rgba(30,50,80,0.16);background:#fff;font-size:0.875rem;color:#060c19;outline:none;transition:all 0.15s;box-sizing:border-box;font-family:inherit"
                       onfocus="this.style.borderColor='#b01616';this.style.boxShadow='0 0 0 3px rgba(176,22,22,0.08)'"
                       onblur="this.style.borderColor='rgba(30,50,80,0.16)';this.style.boxShadow='none'" />
              </div>
              <div>
                <label for="hy-phone" style="display:block;font-size:0.72rem;font-weight:800;color:#060c19;margin-bottom:5px;letter-spacing:0.06em">PHONE NUMBER</label>
                <input type="tel" id="hy-phone" name="phone" autocomplete="tel" required placeholder="(704) 555-0100"
                       style="width:100%;padding:11px 14px;border-radius:9px;border:1.5px solid rgba(30,50,80,0.16);background:#fff;font-size:0.875rem;color:#060c19;outline:none;transition:all 0.15s;box-sizing:border-box;font-family:inherit"
                       onfocus="this.style.borderColor='#b01616';this.style.boxShadow='0 0 0 3px rgba(176,22,22,0.08)'"
                       onblur="this.style.borderColor='rgba(30,50,80,0.16)';this.style.boxShadow='none'" />
              </div>
            </div>

            <div>
              <label for="hy-job-type" style="display:block;font-size:0.72rem;font-weight:800;color:#060c19;margin-bottom:5px;letter-spacing:0.06em">JOB TYPE</label>
              <select id="hy-job-type" name="job_type" required
                      style="width:100%;padding:11px 14px;border-radius:9px;border:1.5px solid rgba(30,50,80,0.16);background:#fff;font-size:0.875rem;color:#060c19;outline:none;transition:all 0.15s;appearance:none;box-sizing:border-box;font-family:inherit"
                      onfocus="this.style.borderColor='#b01616'" onblur="this.style.borderColor='rgba(30,50,80,0.16)'">
                <option value="" disabled selected>Select job type…</option>
                <option>Drywall Repair</option>
                <option>Door Repair / Adjustment</option>
                <option>TV Mounting</option>
                <option>Furniture Assembly</option>
                <option>Shelf / Storage Installation</option>
                <option>Cabinet Repair</option>
                <option>Trim & Baseboard Repair</option>
                <option>Rental Turnover / Punch List</option>
                <option>Small Carpentry</option>
                <option>Multiple Repairs (List)</option>
                <option>Other Handyman Job</option>
              </select>
            </div>

            <div>
              <label for="hy-desc" style="display:block;font-size:0.72rem;font-weight:800;color:#060c19;margin-bottom:5px;letter-spacing:0.06em">DESCRIBE THE JOB</label>
              <textarea id="hy-desc" name="message" rows="3" placeholder="Describe what needs to be done — list multiple items if needed…"
                        style="width:100%;padding:11px 14px;border-radius:9px;border:1.5px solid rgba(30,50,80,0.16);background:#fff;font-size:0.875rem;color:#060c19;outline:none;transition:all 0.15s;resize:none;box-sizing:border-box;font-family:inherit"
                        onfocus="this.style.borderColor='#b01616';this.style.boxShadow='0 0 0 3px rgba(176,22,22,0.08)'"
                        onblur="this.style.borderColor='rgba(30,50,80,0.16)';this.style.boxShadow='none'"></textarea>
            </div>

            <button id="hy-submit" type="submit" class="btn-red" style="width:100%;padding:14px;font-size:0.97rem;border-radius:10px">
              Book Handyman Service →
            </button>
            <p style="font-size:0.69rem;color:#9aaabe;text-align:center;margin:0;font-weight:400">We respect your privacy. Your info is never sold or shared.</p>
          </form>

          <div id="hy-success" style="display:none;padding:40px 32px;text-align:center">
            <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(180deg,#d42222,#8e1010);display:flex;align-items:center;justify-content:center;margin:0 auto 18px">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
            </div>
            <p style="font-size:1.05rem;font-weight:800;color:#060c19;margin:0 0 6px;letter-spacing:-0.01em">Request received.</p>
            <p style="font-size:0.88rem;color:#4a5e74;margin:0;font-weight:400">We'll call you shortly.</p>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />

  <style>
    /* Book Service link — CSS hover replaces JS style.gap writes (layout reflow fix) */
    .hy-book-link {
      font-size: 0.76rem;
      font-weight: 700;
      color: #b01616;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: gap 0.15s;
    }
    .hy-book-link:hover { gap: 8px; }
  </style>

  <script>
    const form = document.getElementById('handyman-form') as HTMLFormElement | null;
    const success = document.getElementById('hy-success');
    const btn = document.getElementById('hy-submit') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!btn) return;
      btn.disabled = true;
      btn.textContent = 'Sending…';

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await res.json();
        if (data.success) {
          form.style.display = 'none';
          if (success) success.style.display = 'block';
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'generate_lead', method: 'request_service_form' });
          console.log('[GTM] generate_lead pushed');
        } else {
          btn.disabled = false;
          btn.textContent = 'Book Handyman Service →';
          alert('Something went wrong. Please call us directly.');
        }
      } catch {
        btn.disabled = false;
        btn.textContent = 'Book Handyman Service →';
        alert('Something went wrong. Please call us directly.');
      }
    });
  </script>
