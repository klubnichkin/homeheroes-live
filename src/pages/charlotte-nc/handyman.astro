const faqs = [
  {
    q: 'Do you offer same-day handyman service in Charlotte?',
    a: 'Yes. HomeHeroes provides same-day handyman service across Charlotte and the surrounding metro including Huntersville, Mooresville, Concord, Matthews, and Cornelius. Call (704) 512-0111 and we\'ll confirm your appointment within minutes.',
  },
  {
    q: 'What types of handyman jobs do you handle?',
    a: 'We handle most small-to-medium home repair and installation tasks: drywall repair, door adjustments, TV mounting, furniture assembly, shelf installation, cabinet repair, trim and baseboard work, weatherstripping, bathroom accessories, and general punch-list repairs. If you\'re unsure whether your job fits, call us — we\'re happy to assess over the phone.',
  },
  {
    q: 'Do you work with landlords and property managers?',
    a: 'Absolutely. HomeHeroes is a preferred partner for property managers and landlords across the Charlotte metro. We handle rental turnover punch lists, tenant damage repairs, move-in/move-out condition work, and recurring maintenance tasks. We can coordinate multi-unit and multi-location scheduling.',
  },
  {
    q: 'Can I book multiple small repairs in one visit?',
    a: 'Yes — and we encourage it. Batching repairs into one visit is more efficient and cost-effective for you. Tell us everything on your list when you call or book online, and we\'ll block the right amount of time for your tech.',
  },
  {
    q: 'Do you provide estimates before work starts?',
    a: 'Yes. HomeHeroes provides upfront quotes before any work begins. We charge a $79 service call fee that is applied toward your repair total when you approve the work — no surprise charges, no hourly billing ambiguity.',
  },
  {
    q: 'What handyman jobs do you not handle?',
    a: 'We don\'t take on major structural work, load-bearing wall modifications, full electrical panel work, full plumbing system installations, roofing, or projects requiring specialized permits we can\'t coordinate. We\'ll be upfront if a job is outside our scope and point you to the right specialist.',
  },
];

const notDone = [
  { t: 'Major structural or load-bearing work',     d: 'Wall removals, foundation work, or anything structural' },
  { t: 'Full electrical panel or rewiring jobs',    d: 'We refer these to our licensed electrical partners' },
  { t: 'Full plumbing system installations',        d: 'Pipe reroutes or new system installs go to our plumbing team' },
  { t: 'Roofing & major exterior reconstruction',   d: 'Requires specialized trade licensing' },
  { t: 'Large remodeling or permit-required builds', d: 'Kitchen/bath gut-remodels, additions, etc.' },
];
