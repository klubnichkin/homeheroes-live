---
import SeoPageLayout from '../layouts/SeoPageLayout.astro';
import StickyMobileCTA from '../components/cro/StickyMobileCTA.astro';
import { phone, phoneHref } from '../data/siteData';

const base = 'https://tryhomeheroes.com';
const canonical = `${base}/airbnb-maintenance-charlotte`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Airbnb Maintenance & Punch List Service in Charlotte, NC",
  "description": "Home Heroes helps Airbnb hosts and property managers in Charlotte with maintenance, turnover repairs and punch lists including drywall, TV mounting, fixtures, furniture, faucets and handyman work.",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Home Heroes",
    "url": base,
    "telephone": phone,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Charlotte",
      "addressRegion": "NC",
      "addressCountry": "US"
    }
  },
  "areaServed": { "@type": "City", "name": "Charlotte", "addressRegion": "NC" },
  "serviceType": "Airbnb Maintenance, Short-Term Rental Maintenance, Turnover Punch List",
  "url": canonical
};

const repairs = [
  { id: 'drywall-repair',      n: 1,  label: 'Drywall Repair' },
  { id: 'tv-mounting',         n: 2,  label: 'TV Mounting' },
  { id: 'door-repair',         n: 3,  label: 'Door & Handle Repair' },
  { id: 'bathroom-caulking',   n: 4,  label: 'Bathroom Caulking' },
  { id: 'light-fixture',       n: 5,  label: 'Light Fixture Replacement' },
  { id: 'furniture-assembly',  n: 6,  label: 'Furniture Assembly' },
  { id: 'faucet-replacement',  n: 7,  label: 'Faucet Replacement' },
  { id: 'cabinet-repair',      n: 8,  label: 'Cabinet Hinge & Hardware' },
  { id: 'wall-touchups',       n: 9,  label: 'Wall Touch-Ups' },
  { id: 'hvac-filter',         n: 10, label: 'HVAC Filter Replacement' },
  { id: 'smoke-co',            n: 11, label: 'Smoke & CO Detector' },
  { id: 'wall-anchor',         n: 12, label: 'Wall Anchor & Hardware' },
];
---

<SeoPageLayout
  title="Airbnb Maintenance & Punch List Service in Charlotte, NC | Home Heroes"
  description="Common short-term rental repairs in Charlotte: what they involve, typical price ranges, difficulty and how to group them into one punch list. Drywall, TV mounting, faucets, fixtures, furniture and more."
  canonical={canonical}
  schema={schema}
  ogImage="/images/airbnb/tv-mounting-airbnb-after.png"
>

<StickyMobileCTA phone={phone} phoneHref={phoneHref} label="Send Punch List" />

<style>
  .repair-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 0;
    max-width: 1080px;
    margin: 0 auto;
    align-items: start;
  }
  .repair-toc {
    position: sticky;
    top: 24px;
    padding: 24px 0 24px 24px;
  }
  .repair-content {
    padding: 0 24px 0 32px;
    min-width: 0;
  }
  .repair-section {
    padding: 48px 0;
    border-bottom: 1px solid rgba(30,50,80,0.09);
  }
  .repair-section:last-child {
    border-bottom: none;
  }
  .fact-bar {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 8px;
    margin: 18px 0 24px;
  }
  .fact-cell {
    background: #f8f9fc;
    border-radius: 9px;
    padding: 12px 14px;
    border: 1.5px solid rgba(30,50,80,0.08);
  }
  .before-after-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 20px 0 24px;
    border-radius: 12px;
    overflow: hidden;
  }
  .before-after-grid img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }
  .single-image {
    margin: 20px 0 24px;
    border-radius: 12px;
    overflow: hidden;
  }
  .single-image img {
    width: 100%;
    max-height: 260px;
    object-fit: cover;
    display: block;
  }
  .airbnb-callout {
    background: linear-gradient(135deg, #fff8f8, #fff);
    border-left: 4px solid #dc2626;
    border-radius: 0 10px 10px 0;
    padding: 14px 18px;
    margin: 20px 0;
  }
  .complexity-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .complexity-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.875rem;
    color: #4a5e74;
    line-height: 1.5;
  }
  .btn-punch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #080f1e;
    color: #fff;
    font-weight: 700;
    font-size: 0.875rem;
    padding: 11px 20px;
    border-radius: 8px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s;
  }
  .btn-punch:hover { background: #dc2626; }
  .toc-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 7px;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    color: #2a3a52;
    transition: background 0.1s, color 0.1s;
    line-height: 1.3;
  }
  .toc-link:hover { background: rgba(220,38,38,0.07); color: #dc2626; }
  .toc-link.active { background: rgba(220,38,38,0.1); color: #dc2626; }
  .toc-num {
    font-size: 0.72rem;
    font-weight: 800;
    color: #9aaabe;
    width: 18px;
    flex-shrink: 0;
    text-align: right;
  }
  @media (max-width: 760px) {
    .repair-layout {
      grid-template-columns: 1fr;
    }
    .repair-toc {
      position: static;
      padding: 0 16px 16px;
    }
    .repair-content {
      padding: 0 16px;
    }
    .fact-bar {
      grid-template-columns: repeat(2,1fr);
    }
    .before-after-grid img {
      height: 160px;
    }
  }
  @media (max-width: 480px) {
    .before-after-grid {
      grid-template-columns: 1fr;
    }
    .before-after-grid img {
      height: 200px;
    }
  }
</style>

<!-- ================================================================
  SHORT HERO
================================================================ -->
<section style="background:linear-gradient(150deg,#080f1e,#0e1a32);padding:44px 24px 40px;border-bottom:1px solid rgba(255,255,255,0.06)">
  <div style="max-width:1080px;margin:0 auto">
    <p style="font-size:0.7rem;font-weight:800;letter-spacing:0.14em;color:#dc2626;text-transform:uppercase;margin:0 0 10px">Airbnb / STR Maintenance in Charlotte, NC</p>
    <h1 style="font-size:clamp(1.6rem,4vw,2.6rem);font-weight:900;color:#fff;letter-spacing:-0.035em;line-height:1.1;margin:0 0 12px;max-width:680px">
      Airbnb Maintenance &amp; Punch List Service<br />in Charlotte, NC
    </h1>
    <p style="font-size:0.95rem;color:rgba(200,215,240,0.72);line-height:1.6;margin:0 0 22px;max-width:580px">
      Common short-term rental repairs, what they involve, typical price ranges, and how to group them into one punch list instead of five contractor calls.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:10px">
      <a href="#punch-list-form"
         style="display:inline-flex;align-items:center;gap:7px;background:#dc2626;color:#fff;font-weight:800;font-size:0.9rem;padding:12px 24px;border-radius:9px;text-decoration:none">
        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        Send Us Your Punch List
      </a>
      <a href="#repair-guide"
         style="display:inline-flex;align-items:center;gap:7px;color:rgba(200,215,240,0.75);font-weight:600;font-size:0.9rem;padding:12px 20px;border-radius:9px;text-decoration:none;border:1.5px solid rgba(255,255,255,0.16)">
        View Repairs
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ================================================================
  REPAIR GUIDE — two-column layout: sticky TOC + content
================================================================ -->
<div id="repair-guide" style="background:#fff;padding:32px 0 80px">

  <!-- Mobile TOC (collapsible) -->
  <div style="display:none;padding:0 16px 16px" class="mobile-toc-wrap">
    <details style="background:#f8f9fc;border-radius:10px;border:1.5px solid rgba(30,50,80,0.09);overflow:hidden">
      <summary style="padding:12px 16px;font-size:0.85rem;font-weight:700;color:#080f1e;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center">
        Jump to a repair
        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="color:#dc2626"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div style="padding:8px 12px 12px;display:flex;flex-direction:column;gap:2px">
        {repairs.map(r => (
          <a href={`#${r.id}`} class="toc-link">
            <span class="toc-num">{r.n}</span>
            {r.label}
          </a>
        ))}
      </div>
    </details>
  </div>

  <div class="repair-layout">

    <!-- DESKTOP STICKY TOC -->
    <aside class="repair-toc desktop-toc">
      <div style="background:#f8f9fc;border-radius:12px;border:1.5px solid rgba(30,50,80,0.09);overflow:hidden">
        <div style="padding:14px 16px;border-bottom:1px solid rgba(30,50,80,0.08);background:#080f1e">
          <p style="font-size:0.65rem;font-weight:800;letter-spacing:0.12em;color:#dc2626;text-transform:uppercase;margin:0 0 2px">Airbnb Maintenance</p>
          <p style="font-size:0.82rem;font-weight:700;color:#fff;margin:0">Repair Guide</p>
        </div>
        <div style="padding:8px 8px 10px">
          <p style="font-size:0.68rem;font-weight:700;letter-spacing:0.08em;color:#9aaabe;text-transform:uppercase;padding:4px 10px 8px;margin:0">Jump to a repair:</p>
          <nav style="display:flex;flex-direction:column;gap:1px">
            {repairs.map(r => (
              <a href={`#${r.id}`} class="toc-link">
                <span class="toc-num">{r.n}</span>
                {r.label}
              </a>
            ))}
          </nav>
        </div>
        <div style="padding:12px 14px;border-top:1px solid rgba(30,50,80,0.08);background:#fafbfd">
          <a href="#punch-list-form"
             style="display:flex;align-items:center;justify-content:center;gap:6px;background:#dc2626;color:#fff;font-weight:800;font-size:0.8rem;padding:10px 14px;border-radius:7px;text-decoration:none;text-align:center">
            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            Send Your Punch List
          </a>
        </div>
      </div>
      <div style="margin-top:16px;background:#fff8f8;border-radius:10px;border:1.5px solid rgba(220,38,38,0.15);padding:14px">
        <p style="font-size:0.72rem;font-weight:700;color:#080f1e;margin:0 0 5px">Price Note</p>
        <p style="font-size:0.72rem;color:#6a7a8e;margin:0;line-height:1.55">Prices below are general planning ranges for common small jobs in Charlotte. Actual pricing depends on materials, access, condition, finish requirements and scope.</p>
      </div>
    </aside>

    <!-- REPAIR SECTIONS -->
    <main class="repair-content">

      <!-- Price disclaimer (mobile visible) -->
      <div style="background:#fff8f8;border-radius:10px;border:1.5px solid rgba(220,38,38,0.15);padding:14px 16px;margin:0 0 8px" class="price-note-mobile">
        <p style="font-size:0.78rem;color:#6a7a8e;margin:0;line-height:1.55"><strong style="color:#080f1e">Price note:</strong> Prices below are general planning ranges for common small jobs in Charlotte. Actual pricing depends on materials, access, condition, finish requirements and scope.</p>
      </div>

      <!-- ======================================================
        SECTION 1: DRYWALL REPAIR
      ====================================================== -->
      <section id="drywall-repair" class="repair-section">
        <div style="display:flex;align-items:center;gap:12px;margin:0 0 6px">
          <span style="width:28px;height:28px;border-radius:7px;background:#dc2626;color:#fff;font-size:0.78rem;font-weight:900;display:flex;align-items:center;justify-content:center;flex-shrink:0">1</span>
          <h2 style="font-size:1.4rem;font-weight:900;color:#080f1e;letter-spacing:-0.025em;margin:0;line-height:1.1">Drywall Repair</h2>
        </div>
        <p style="font-size:0.82rem;color:#8a9ab0;margin:0 0 4px;font-weight:500">Common short-term rental repair</p>

        <div class="before-after-grid">
          <div style="position:relative">
            <img src="/images/airbnb/drywall-repair-airbnb-before.png" alt="Large hole in drywall from guest damage in Charlotte rental before repair" loading="lazy" width="400" height="220" />
            <span style="position:absolute;top:8px;left:8px;background:rgba(8,15,30,0.75);color:#fff;font-size:0.6rem;font-weight:800;letter-spacing:0.1em;padding:3px 7px;border-radius:4px;text-transform:uppercase">Before</span>
          </div>
          <div style="position:relative">
            <img src="/images/airbnb/drywall-repair-airbnb-after.png" alt="Repaired and painted drywall in Charlotte rental after patch and texture" loading="lazy" width="400" height="220" />
            <span style="position:absolute;top:8px;left:8px;background:rgba(176,22,22,0.82);color:#fff;font-size:0.6rem;font-weight:800;letter-spacing:0.1em;padding:3px 7px;border-radius:4px;text-transform:uppercase">After</span>
          </div>
        </div>

        <div class="fact-bar">
          <div class="fact-cell">
            <p style="font-size:0.64rem;font-weight:800;letter-spacing:0.08em;color:#9aaabe;text-transform:uppercase;margin:0 0 3px">Typical Cost</p>
            <p style="font-size:0.88rem;font-weight:800;color:#080f1e;margin:0">$150 - $450</p>
          </div>
          <div class="fact-cell">
            <p style="font-size:0.64rem;font-weight:800;letter-spacing:0.08em;color:#9aaabe;text-transform:uppercase;margin:0 0 3px">Difficulty</p>
            <p style="font-size:0.88rem;font-weight:800;color:#080f1e;margin:0">Moderate</p>
          </div>
          <div class="fact-cell">
            <p style="font-size:0.64rem;font-weight:800;letter-spacing:0.08em;color:#9aaabe;text-transform:uppercase;margin:0 0 3px">Typical Time</p>
            <p style="font-size:0.88rem;font-weight:800;color:#080f1e;margin:0">1–3 hrs</p>
          </div>
          <div class="fact-cell">
            <p style="font-size:0.64rem;font-weight:800;letter-spacing:0.08em;color:#9aaabe;text-transform:uppercase;margin:0 0 3px">Best For</p>
            <p style="font-size:0.88rem;font-weight:800;color:#080f1e;margin:0">Guest damage</p>
          </div>
        </div>

        <p style="font-size:0.92rem;color:#2a3a52;line-height:1.7;margin:0 0 14px"><strong style="color:#080f1e">What it usually looks like:</strong> A hole from a door handle punching through, a removed TV mount leaving craters in the wall, broken drywall from a moved piece of furniture, or general guest damage found during turnover inspection.</p>
        <p style="font-size:0.92rem;color:#2a3a52;line-height:1.7;margin:0 0 14px"><strong style="color:#080f1e">Goal:</strong> Remove loose material, stabilize the damaged area, apply patch and compound, sand, and prepare the surface for paint so the repair disappears into the surrounding wall.</p>
        <p style="font-size:0.92rem;color:#2a3a52;line-height:1.7;margin:0 0 16px"><strong style="color:#080f1e">Usually includes:</strong> Removing loose material, squaring the damaged area, patching, taping, joint compound, sanding, and basic finish preparation. Note that compound requires drying time, and a return visit for paint may be needed depending on finish requirements.</p>

        <div style="margin:0 0 16px">
          <p style="font-size:0.82rem;font-weight:700;color:#080f1e;margin:0 0 8px">What increases cost or complexity:</p>
          <ul class="complexity-list">
            {['Large or irregular damage area','Texture matching on existing wall','Ceiling repairs (access, compound drip, viewing angle)','Water damage or mold present','Damaged framing behind the drywall','Paint matching when existing color is unknown'].map(i => (
              <li>
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#dc2626" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {i}
              </li>
            ))}
          </ul>
        </div>

        <div class="airbnb-callout">
          <p style="font-size:0.82rem;font-weight:800;color:#dc2626;margin:0 0 4px;letter-spacing:0.02em">Airbnb Relevance</p>
          <p style="font-size:0.875rem;color:#2a3a52;margin:0;line-height:1.6">Wall damage is immediately visible to guests and photographs badly in listing photos. A drywall repair should disappear into the wall before the next guest arrives.</p>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center">
          <button class="btn-punch" onclick="addToPunchList('Drywall repair')">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            Add Drywall Repair to My Punch List
          </button>
          <a href="/charlotte-nc/handyman" style="font-size:0.82rem;color:#dc2626;font-weight:600;text-decoration:none">Handyman services in Charlotte</a>
        </div>
      </section>

      <!-- ======================================================
        SECTION 2: TV MOUNTING
      ====================================================== -->
      <section id="tv-mounting" class="repair-section">
        <div style="display:flex;align-items:center;gap:12px;margin:0 0 6px">
          <span style="width:28px;height:28px;border-radius:7px;background:#dc2626;color:#fff;font-size:0.78rem;font-weight:900;display:flex;align-items:center;justify-content:center;flex-shrink:0">2</span>
          <h2 style="font-size:1.4rem;font-weight:900;color:#080f1e;letter-spacing:-0.025em;margin:0;line-height:1.1">TV Mounting</h2>
        </div>
        <p style="font-size:0.82rem;color:#8a9ab0;margin:0 0 4px;font-weight:500">Installation, remounting &amp; leveling</p>

        <div class="before-after-grid">
          <div style="position:relative">
            <img src="/images/airbnb/tv-mounting-airbnb-before.png" alt="Unboxed TV leaning against wall in Uptown Charlotte rental before mounting" loading="lazy" width="400" height="220" />
            <span style="position:absolute;top:8px;left:8px;background:rgba(8,15,30,0.75);color:#fff;font-size:0.6rem;font-weight:800;letter-spacing:0.1em;padding:3px 7px;border-radius:4px;text-transform:uppercase">Before</span>
          </div>
          <div style="position:relative">
            <img src="/images/airbnb/tv-mounting-airbnb-after.png" alt="Mounted TV on living room wall in Charlotte short-term rental" loading="lazy" width="400" height="220" />
            <span style="position:absolute;top:8px;left:8px;background:rgba(176,22,22,0.82);color:#fff;font-size:0.6rem;font-weight:800;letter-spacing:0.1em;padding:3px 7px;border-radius:4px;text-transform:uppercase">After</span>
          </div>
        </div>

        <div class="fact-bar">
          <div class="fact-cell">
            <p style="font-size:0.64rem;font-weight:800;letter-spacing:0.08em;color:#9aaabe;text-transform:uppercase;margin:0 0 3px">Typical Cost</p>
            <p style="font-size:0.88rem;font-weight:800;color:#080f1e;margin:0">$125 - $300</p>
          </div>
          <div class="fact-cell">
            <p style="font-size:0.64rem;font-weight:800;letter-spacing:0.08em;color:#9aaabe;text-transform:uppercase;margin:0 0 3px">Difficulty</p>
            <p style="font-size:0.88rem;font-weight:800;color:#080f1e;margin:0">Easy–Moderate</p>
          </div>
          <div class="fact-cell">
            <p style="font-size:0.64rem;font-weight:800;letter-spacing:0.08em;color:#9aaabe;text-transform:uppercase;margin:0 0 3px">Typical Time</p>
            <p style="font-size:0.88rem;font-weight:800;color:#080f1e;margin:0">1–2 hrs</p>
          </div>
          <div class="fact-cell">
            <p style="font-size:0.64rem;font-weight:800;letter-spacing:0.08em;color:#9aaabe;text-transform:uppercase;margin:0 0 3px">Best For</p>
            <p style="font-size:0.88rem;font-weight:800;color:#080f1e;margin:0">New setup / turnover</p>
          </div>
        </div>

        <p style="font-size:0.92rem;color:#2a3a52;line-height:1.7;margin:0 0 14px"><strong style="color:#080f1e">Common requests:</strong> New TV needs installing before listing goes live, existing mount fell or shifted after guest use, TV needs repositioning after furniture was rearranged, or an old mount needs replacing with a full-motion bracket.</p>
        <p style="font-size:0.92rem;color:#2a3a52;line-height:1.7;margin:0 0 14px"><strong style="color:#080f1e">Goal:</strong> Secure the TV safely to the wall, position it at the correct viewing height, level it, and make the room look put-together for guests.</p>
        <p style="font-size:0.92rem;color:#2a3a52;line-height:1.7;margin:0 0 16px"><strong style="color:#080f1e">Usually includes:</strong> Stud and mounting-point check, bracket installation, leveling, TV placement, and basic cable organization.</p>

        <div style="margin:0 0 16px">
          <p style="font-size:0.82rem;font-weight:700;color:#080f1e;margin:0 0 8px">What increases cost or complexity:</p>
          <ul class="complexity-list">
            {['Large TV (85"+) requiring two installers','Masonry or brick wall','In-wall cable management','Replacing an existing damaged mount','Unusual wall structure or hollow-core situations','TV over a fireplace (angle, heat considerations)'].map(i => (
              <li>
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#dc2626" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
