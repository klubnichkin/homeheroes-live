</section>

<script>
  /* Form submission */
  const plForm = document.getElementById('punch-list-submit') as HTMLFormElement | null;
  const plSuccess = document.getElementById('pl-success');
  const plBtn = document.getElementById('pl-btn') as HTMLButtonElement | null;

  plForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!plBtn) return;
    plBtn.disabled = true;
    plBtn.textContent = 'Sending…';
    try {
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(plForm) });
      const data = await res.json();
      if (data.success) {
        plForm.style.display = 'none';
        if (plSuccess) plSuccess.style.display = 'block';
        (window as any).dataLayer = (window as any).dataLayer || [];
        (window as any).dataLayer.push({ event: 'generate_lead', method: 'airbnb_punch_list_form' });
      } else {
        plBtn.disabled = false;
        plBtn.textContent = 'Send My Punch List';
        alert('Something went wrong. Please call us directly.');
      }
    } catch {
      plBtn.disabled = false;
      plBtn.textContent = 'Send My Punch List';
      alert('Something went wrong. Please call us directly.');
    }
  });

  /* "Add to punch list" buttons: append repair name to textarea and scroll to form */
  function addToPunchList(item: string) {
    const ta = document.getElementById('pl-tasks') as HTMLTextAreaElement | null;
    if (ta) {
      ta.value = ta.value ? ta.value + '\n' + item : item;
      ta.focus();
    }
    const form = document.getElementById('punch-list-form');
    form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  (window as any).addToPunchList = addToPunchList;

  /* Mobile TOC show/hide via CSS */
  function applyResponsiveToc() {
    const mobile = document.querySelector('.mobile-toc-wrap') as HTMLElement | null;
    const desktop = document.querySelector('.desktop-toc') as HTMLElement | null;
    const priceNoteMobile = document.querySelector('.price-note-mobile') as HTMLElement | null;
    if (window.innerWidth <= 760) {
      if (mobile) mobile.style.display = 'block';
      if (desktop) desktop.style.display = 'none';
      if (priceNoteMobile) priceNoteMobile.style.display = 'block';
    } else {
      if (mobile) mobile.style.display = 'none';
      if (desktop) desktop.style.display = 'block';
      if (priceNoteMobile) priceNoteMobile.style.display = 'none';
    }
  }
  applyResponsiveToc();
  window.addEventListener('resize', applyResponsiveToc);
</script>

