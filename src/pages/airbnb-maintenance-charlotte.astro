<script>
  const plForm = document.getElementById('punch-list-submit') as HTMLFormElement | null;
  const plSuccess = document.getElementById('pl-success');
  const plBtn = document.getElementById('pl-submit-btn') as HTMLButtonElement | null;

  plForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!plBtn) return;
    plBtn.disabled = true;
    plBtn.textContent = 'Sending…';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(plForm),
      });
      const data = await res.json();
      if (data.success) {
        plForm.style.display = 'none';
        if (plSuccess) plSuccess.style.display = 'block';
        (window as any).dataLayer = (window as any).dataLayer || [];
        (window as any).dataLayer.push({ event: 'generate_lead', method: 'airbnb_punch_list_form' });
      } else {
        plBtn.disabled = false;
        plBtn.textContent = 'Send My Punch List';
        alert('Something went wrong. Please call us directly at {phone}.');
      }
    } catch {
      plBtn.disabled = false;
      plBtn.textContent = 'Send My Punch List';
      alert('Something went wrong. Please call us directly.');
    }
  });
</script>

