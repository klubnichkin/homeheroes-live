<section style="background:linear-gradient(135deg,#080f1e 0%,#101c38 100%);padding:80px 24px 88px">
  <div style="max-width:660px;margin:0 auto;text-align:center">
    <h2 style="font-size:clamp(2rem,5vw,3rem);font-weight:900;color:#fff;letter-spacing:-0.04em;line-height:1.06;margin:0 0 18px">
      Got a Punch List?<br /><span style="color:#dc2626">Send It.</span>
    </h2>
    <p style="font-size:1rem;color:rgba(200,215,240,0.78);line-height:1.7;margin:0 auto 36px;max-width:480px">
      Whether it is three small repairs or a full turnover list, send us the property details, photos and everything that needs attention. We'll help organize the work and determine the next step.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin:0 0 14px">
      <a href="#punch-list-form"
         style="display:inline-flex;align-items:center;gap:8px;background:#dc2626;color:#fff;font-weight:800;font-size:1rem;padding:15px 32px;border-radius:10px;text-decoration:none;box-shadow:0 6px 24px rgba(220,38,38,0.3)">
        <svg width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        Send Us Your Punch List
      </a>
      <a href={phoneHref}
         style="display:inline-flex;align-items:center;gap:8px;color:#fff;font-weight:700;font-size:1rem;padding:15px 28px;border-radius:10px;text-decoration:none;border:2px solid rgba(255,255,255,0.22);background:rgba(255,255,255,0.07)">
        Schedule Airbnb Maintenance
      </a>
    </div>
    <a href="#punch-list-form"
       style="display:inline-block;font-size:0.88rem;color:rgba(200,215,240,0.55);font-weight:500;text-decoration:underline;text-underline-offset:3px">
      Managing Multiple Properties? Talk to Us
    </a>
  </div>
</section>

</SeoPageLayout>
