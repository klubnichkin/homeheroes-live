  <StickyMobileCTA phone={phone} phoneHref={phoneHref} label="Get Install Quote" />

</SeoPageLayout>

<script>
  const form = document.getElementById('install-quote-form') as HTMLFormElement | null;
  const success = document.getElementById('inst-success');
  const btn = document.getElementById('inst-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn) return;
    btn.disabled = true;
    btn.textContent = 'Sending…';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form),
      });
      const data = await res.json();
      if (data.success) {
        form.style.display = 'none';
        if (success) success.style.display = 'block';
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'generate_lead', method: 'refrigerator_install_form' });
        console.log('[GTM] generate_lead pushed');
      } else {
        btn.disabled = false;
        btn.textContent = 'Get Installation Quote →';
        alert('Something went wrong. Please call us directly.');
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Get Installation Quote →';
      alert('Something went wrong. Please call us directly.');
    }
  });
</script>
