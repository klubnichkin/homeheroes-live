              ))}
            </div>
          </div>
          <div>
            <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:#9aaabe;margin-bottom:10px">Refrigerator</div>
            <div style="display:flex;flex-direction:column;gap:5px">
              {['Correct dimensions verified','Capacity appropriate','Model number recorded','Parts availability checked','Warranty confirmed','Ice / water actually needed','EnergyGuide reviewed','Delivery cost','Installation cost','Haul-away included'].map(item => (
                <div style="font-size:0.79rem;color:#2a3c54;display:flex;gap:6px;align-items:center"><span style="width:13px;height:13px;border:1.5px solid rgba(30,50,80,0.2);border-radius:3px;flex-shrink:0;display:inline-block"></span>{item}</div>
              ))}
            </div>
          </div>
          <div>
            <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:#9aaabe;margin-bottom:10px">Used / Open-Box</div>
            <div style="display:flex;flex-direction:column;gap:5px">
              {['Warranty terms confirmed','Cosmetic vs functional damage noted','Door seals inspected','Cooling verified','Serial number photographed','Return policy understood'].map(item => (
                <div style="font-size:0.79rem;color:#2a3c54;display:flex;gap:6px;align-items:center"><span style="width:13px;height:13px;border:1.5px solid rgba(30,50,80,0.2);border-radius:3px;flex-shrink:0;display:inline-block"></span>{item}</div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- RELATED -->
      <div style="padding:20px 22px;background:#fff;border:1px solid rgba(30,50,80,0.08);border-radius:12px">
        <div style="font-size:0.63rem;font-weight:800;text-transform:uppercase;letter-spacing:0.14em;color:#9aaabe;margin-bottom:12px">Related Resources</div>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          {[
