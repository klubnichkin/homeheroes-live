        <div id="inst-success" style="display:none;padding:44px 32px;text-align:center">
          <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(180deg,#d42222,#8e1010);display:flex;align-items:center;justify-content:center;margin:0 auto 18px">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
          </div>
          <p style="font-size:1.05rem;font-weight:800;color:#060c19;margin:0 0 6px">Quote request received.</p>
