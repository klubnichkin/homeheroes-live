          <!-- Refrigerator status + brand -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div>
              <label for="inst-status" style="display:block;font-size:0.7rem;font-weight:800;color:#060c19;margin-bottom:5px;letter-spacing:0.06em">REFRIGERATOR STATUS *</label>
              <select id="inst-status" name="refrigerator_status" required
