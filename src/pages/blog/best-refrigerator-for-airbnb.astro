            </div>
            <div>
              <label for="inst-brand" style="display:block;font-size:0.7rem;font-weight:800;color:#060c19;margin-bottom:5px;letter-spacing:0.06em">REFRIGERATOR BRAND</label>
              <input type="text" id="inst-brand" name="refrigerator_brand" placeholder="LG, Samsung, Whirlpool…"
                style="width:100%;padding:11px 13px;border-radius:9px;border:1.5px solid rgba(30,50,80,0.16);background:#fff;font-size:0.875rem;color:#060c19;outline:none;box-sizing:border-box;font-family:inherit"
