            <input type="hidden" name="subject" value="New HomeHeroes Electrical Service Request" />

            <div class="form-row">
              <div>
                <label for="elec-name" style="display:block;font-size:0.72rem;font-weight:800;color:#060c19;margin-bottom:5px;letter-spacing:0.06em">FIRST NAME</label>
                <input type="text" id="elec-name" name="first_name" autocomplete="given-name" required placeholder="John"
