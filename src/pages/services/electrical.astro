---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import ServiceAreas from '../../components/ServiceAreas.astro';
import Footer from '../../components/Footer.astro';
import { phone, phoneHref } from '../../data/siteData';

const problems = [
  {
    title: 'Breakers Keep Tripping',
    detail: 'A breaker that trips repeatedly is telling you something — overloaded circuit, short circuit, or a ground fault. We find the root cause and fix it, not just reset the breaker.',
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  },
  {
    title: 'Outlet Stopped Working',
    detail: 'Dead outlets can be a tripped GFCI upstream, a loose wire connection, a failed receptacle, or a wiring fault. We trace it to the source and restore power safely.',
    icon: 'M5.636 5.636a9 9 0 1012.728 0M12 3v9',
  },
  {
    title: 'Flickering Lights',
    detail: 'Lights that flicker or dim unexpectedly can indicate loose wiring, a failing fixture, an overloaded circuit, or voltage fluctuation from the utility. Some causes are fire hazards.',
    icon: 'M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z',
  },
  {
    title: 'Burning Smell from Outlet',
    detail: 'A burning smell at an outlet or switch means arcing or overheating — a potential fire hazard. Stop using the outlet immediately, switch it off at the breaker, and call us.',
    icon: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z',
  },
  {
    title: 'Light Switch Not Working',
    detail: 'A switch that doesn\'t respond, feels warm, sparks when toggled, or controls nothing is a wiring or device issue. Fast swap or wiring repair — most done same visit.',
    icon: 'M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75',
  },
  {
    title: 'Partial Power Loss',
    detail: 'Half your home losing power while the other half works often points to a failed leg in the service panel — a utility or panel issue that needs prompt attention to avoid appliance damage.',
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  },
  {
    title: 'Frequent Power Surges',
    detail: 'Repeated surges damage appliances and electronics over time. Caused by wiring problems, faulty devices on the circuit, or utility fluctuations. We diagnose and protect your home.',
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  },
  {
    title: 'Dead Outlet',
    detail: 'An outlet with no power at all is usually a tripped GFCI somewhere else on the circuit, a tripped breaker, or a failed device. We restore it quickly — same-visit in most cases.',
    icon: 'M5.636 5.636a9 9 0 1012.728 0M12 3v9',
  },
  {
    title: 'Ceiling Fan Not Working',
    detail: 'Fan won\'t spin, runs only on one speed, wobbles, or hums but doesn\'t move. Capacitor failure, wiring fault, bad switch, or loose mounting — diagnosed and fixed same day.',
    icon: 'M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z',
  },
  {
    title: 'Electrical Panel Issues',
    detail: 'Warm panel, buzzing sounds, breakers that won\'t reset, or a panel over 20 years old are warning signs. We assess, repair, or recommend an upgrade based on what we actually find.',
    icon: 'M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H3.75A2.25 2.25 0 011.5 15V5.25m19.5 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 7.409a2.25 2.25 0 01-1.07-1.916V5.25',
  },
];

const faqs = [
  {
    q: 'How much does an electrician cost in Charlotte?',
    a: 'Most residential electrical repairs in Charlotte range from $89–$550 depending on the scope. HomeHeroes charges a $79 service call fee applied toward your repair when you approve the work. Outlet replacements typically run $89–$175. GFCI installation runs $100–$200. Breaker replacement starts at $125. Panel work is quoted after a full assessment. We give you an upfront price before touching anything — no hourly surprises.',
  },
  {
    q: 'Why does my breaker keep tripping?',
    a: 'A breaker trips for a reason — it\'s protecting your home. The three most common causes are: (1) an overloaded circuit with too many devices drawing power, (2) a short circuit from a wiring fault or damaged appliance, or (3) a ground fault where current is flowing somewhere it shouldn\'t. Resetting it without finding the cause risks a fire. We diagnose the underlying problem before recommending a fix.',
  },
  {
    q: 'Is a flickering light dangerous?',
    a: 'It depends on the cause. A single bulb flickering is usually a loose bulb or a failing fixture — low risk. Multiple lights flickering on the same circuit, or flickering throughout the home, can indicate loose wiring connections or a neutral problem — which can cause arcing and is a fire hazard. If more than one light is affected, call us to assess.',
  },
  {
    q: 'Can you replace outlets and switches?',
    a: 'Yes. We replace standard outlets, GFCI outlets, AFCI outlets, USB outlets, dimmer switches, three-way switches, and smart switches. Most outlet and switch replacements are completed in a single visit. We also install new outlets in locations that don\'t have one — including outdoor outlets, garage outlets, and dedicated circuits for appliances.',
  },
  {
    q: 'Do I need a panel upgrade?',
    a: 'You may need one if: your panel is 20+ years old, it\'s a recalled brand (Federal Pacific, Zinsco), you\'re frequently tripping breakers with normal usage, you\'re adding an EV charger or major appliance, or you want to add circuits and the panel is full. We assess your current panel honestly and tell you if an upgrade is needed — or if a repair will solve the problem.',
  },
  {
    q: 'How long do electrical repairs take?',
    a: 'Most common repairs — outlet replacements, switch swaps, GFCI installation, breaker replacement, and fixture work — are completed in 1–3 hours on the first visit. Panel work typically takes half a day to a full day. We give you a time estimate when we quote the job so you can plan accordingly.',
  },
  {
    q: 'Do you offer emergency electrical service?',
    a: 'Yes. If you have a burning smell from an outlet, sparking wires, a partial power loss, or any electrical issue that feels unsafe — call (704) 512-0111 immediately. HomeHeroes provides emergency electrical service across Charlotte and the surrounding metro seven days a week. For active hazards: switch off the affected circuit or main breaker while you wait.',
  },
  {
    q: 'Can you install ceiling fans and light fixtures?',
    a: 'Yes. We install ceiling fans and light fixtures in rooms that already have an electrical box, and we can add a new box and wiring where there isn\'t one. Ceiling fan installation with existing wiring typically takes 1–2 hours. We handle all fan sizes, remote kits, and smart fan switches. Recessed lighting, pendant lights, chandeliers, and outdoor fixtures all handled.',
  },
];
