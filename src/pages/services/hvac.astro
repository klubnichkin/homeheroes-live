            { label:'Appliance Repair', desc:'Refrigerators, washers, dryers, ovens and more.',           href:'/appliance-repair-charlotte',  live:true  },
            { label:'Plumbing',         desc:'Drains, leaks, water heaters, emergency plumbing.',          href:'/plumbing-charlotte',           live:true  },
