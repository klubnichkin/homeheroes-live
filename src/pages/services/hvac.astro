---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import ServiceAreas from '../../components/ServiceAreas.astro';
import Footer from '../../components/Footer.astro';
import { phone, phoneHref } from '../../data/siteData';

const problems = [
  {
    title: 'AC Not Cooling',
    detail: 'System runs but the air coming out is warm or room temperature. Typically a refrigerant issue, failed compressor, or dirty coil — diagnosed and repaired same day.',
    icon: 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z',
  },
  {
    title: 'AC Blowing Warm Air',
    detail: 'Warm air from vents while the AC is running points to a refrigerant leak, frozen evaporator coil, or failed condenser fan. We locate the root cause before quoting.',
    icon: 'M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z',
  },
  {
    title: 'HVAC Not Turning On',
    detail: 'No response from your system when the thermostat calls for heat or cool. Could be a tripped breaker, failed capacitor, or control board issue — we trace it fast.',
    icon: 'M5.636 5.636a9 9 0 1012.728 0M12 3v9',
  },
  {
    title: 'Furnace Not Heating',
    detail: 'Furnace cycles but produces little or no heat, or shuts off immediately after starting. Igniter failures, heat exchanger issues, and gas valve problems all resolved.',
    icon: 'M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z',
  },
  {
    title: 'Weak or No Airflow',
    detail: 'Barely any air from your vents despite the system running. Clogged filters, failed blower motor, collapsed ductwork, or a dirty evaporator coil — all diagnosed on the first visit.',
    icon: 'M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3',
  },
  {
    title: 'Strange Noises',
    detail: 'Banging, screeching, rattling, or clicking sounds from your HVAC unit. Worn bearings, loose components, or debris in the system — found and fixed before they cause larger damage.',
    icon: 'M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z',
  },
  {
    title: 'Burning Smell',
    detail: 'A burning or electrical odor from your vents needs immediate attention. Overheating motors, dirty heat exchangers, or electrical faults — shut down the system and call us.',
    icon: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z',
  },
  {
    title: 'High Energy Bills',
    detail: 'A sudden spike in your electric or gas bill often means your HVAC system is working too hard. Low refrigerant, dirty coils, or a failing compressor all drive up energy consumption.',
    icon: 'M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Frozen Evaporator Coil',
    detail: 'Ice forming on your indoor coil shuts down cooling completely. Caused by restricted airflow or low refrigerant — we thaw, diagnose, and resolve the underlying problem.',
    icon: 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z',
  },
  {
    title: 'Thermostat Issues',
    detail: 'System won\'t respond to thermostat commands, temperature reads wrong, or the unit short-cycles. We diagnose wiring faults, calibration issues, and recommend smart upgrades.',
    icon: 'M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75',
  },
];

const faqs = [
  {
    q: 'How much does HVAC repair cost in Charlotte?',
    a: 'Most HVAC repairs in Charlotte range from $89–$650 depending on the issue. HomeHeroes charges a $79 service call fee that is applied toward your repair when you approve the work. Thermostat repairs typically run $89–$200. Capacitor and contactor replacements range from $125–$300. Refrigerant recharge starts at $150. Larger repairs like compressor or heat exchanger work are quoted upfront — no surprises.',
  },
  {
    q: 'Why is my AC running but not cooling?',
    a: 'The most common causes are low refrigerant (due to a leak), a dirty or frozen evaporator coil, a failed condenser fan motor, or a failing compressor. Running the system while it can\'t cool properly can cause additional damage — we recommend shutting it off and calling HomeHeroes for a same-day diagnostic.',
  },
  {
    q: 'Should I repair or replace my HVAC system?',
    a: 'Our honest rule: if your system is under 10 years old and the repair is less than 50% of replacement cost, repair is usually the right call. If it\'s 12–15+ years old, has had multiple failures, and the repair is major, replacement may be more cost-effective long-term. We give you that analysis with every diagnostic — no upselling, just honest numbers.',
  },
  {
    q: 'How often should HVAC systems be serviced?',
    a: 'We recommend annual maintenance for most systems — once in spring for your AC before the Charlotte summer heat hits, and once in fall for your heating before winter. Twice-yearly tune-ups catch small problems before they become expensive failures and keep your system running at peak efficiency.',
  },
  {
    q: 'How long does HVAC repair take?',
    a: 'Most common repairs — capacitor replacements, thermostat swaps, refrigerant recharges, and minor electrical faults — are completed in 1–3 hours on the first visit. Larger repairs like blower motor or heat exchanger replacements may require ordering a part, but we quote turnaround time upfront and keep you updated.',
  },
  {
    q: 'Do you offer emergency HVAC service?',
    a: 'Yes. HomeHeroes provides emergency HVAC service across Charlotte and the surrounding metro. If your AC fails in the middle of a July heat wave or your heat goes out in January, call (704) 512-0111 and we\'ll prioritize your appointment. We dispatch same-day seven days a week.',
  },
  {
    q: 'What HVAC brands do you service?',
    a: 'We service all major HVAC brands including Carrier, Trane, Lennox, Rheem, York, Goodman, American Standard, Bryant, Heil, and more. Our technicians carry common parts for the most widely-installed systems in the Charlotte area — reducing the need for return visits.',
  },
  {
    q: 'How do I know if my furnace needs repair?',
    a: 'Warning signs include: the furnace running but producing no heat, short-cycling (turning on and off rapidly), unusual banging or popping when it starts, a yellow or flickering pilot flame instead of blue, rising gas bills without increased usage, or a burning smell from vents. Any of these warrants a diagnostic call before the issue worsens.',
  },
];
