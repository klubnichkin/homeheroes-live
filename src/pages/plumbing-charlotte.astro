---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import CitationProfiles from '../components/seo/CitationProfiles.astro';
import Footer from '../components/Footer.astro';
import { phone, phoneHref } from '../data/siteData';

const problems = [
  {
    title: 'Clogged Drains',
    detail: 'Kitchen, bathroom, and floor drains cleared fast. We use professional-grade augers and hydro-jetting — not just drain cleaner that temporarily masks the problem.',
    icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  },
  {
    title: 'Leaking Pipes',
    detail: 'Pinhole leaks, burst pipes, supply line failures — located and repaired before water damage spreads. We work on copper, PVC, and PEX systems.',
    icon: 'M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z',
  },
  {
    title: 'Toilet Issues',
    detail: 'Running toilets, clogs, weak flush, rocking base, or complete replacement. Most toilet repairs are completed in under an hour on the first visit.',
    icon: 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z',
  },
  {
    title: 'Water Heater Problems',
    detail: 'No hot water, inconsistent temperature, strange sounds, or visible leaks. We service tank and tankless water heaters — repair or replace, your choice.',
    icon: 'M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z',
  },
  {
    title: 'Low Water Pressure',
    detail: 'Weak flow across faucets or just one fixture? We diagnose pressure regulators, clogged aerators, corroded pipes, and shutoff valve issues.',
    icon: 'M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3',
  },
  {
    title: 'Emergency Plumbing',
    detail: 'Active leak? Water where it shouldn\'t be? Call immediately. We prioritize emergency calls and dispatch same-day — shutoff assistance available over the phone.',
    icon: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z',
  },
];

const faqs = [
  {
    q: 'How much does plumbing repair cost in Charlotte?',
    a: 'Most plumbing repairs in Charlotte range from $79–$450 depending on the issue. HomeHeroes charges a $79 service call fee that is applied toward your repair when you approve the work. Drain clearing typically runs $89–$175. Pipe leak repairs range from $150–$400. Water heater repairs start at $125. We quote upfront before starting — no surprises.',
  },
  {
    q: 'Do you offer same-day plumbing service in Charlotte?',
    a: 'Yes. HomeHeroes provides same-day plumbing service across Charlotte and surrounding areas including Huntersville, Mooresville, Concord, Matthews, and Cornelius. Call (704) 512-0111 and we\'ll confirm your appointment slot within minutes.',
  },
  {
    q: 'What plumbing issues do you handle?',
    a: 'We handle clogged drains, leaking pipes, running toilets, water heater repairs and replacements, low water pressure, sump pump issues, and emergency plumbing. We work on copper, PVC, and PEX systems in both residential and light commercial properties.',
  },
  {
    q: 'Is HomeHeroes licensed and insured for plumbing work?',
    a: 'Yes. HomeHeroes is fully licensed in North Carolina and carries complete liability insurance coverage. Our plumbing technicians are background-checked, uniformed, and trained to NC code standards.',
  },
  {
    q: 'What should I do if I have an active plumbing leak right now?',
    a: 'Locate your main water shutoff valve (usually near the water meter or where the main line enters your home) and shut it off immediately to stop the flow. Then call HomeHeroes at (704) 512-0111 — we can walk you through the shutoff process over the phone and dispatch an emergency technician same-day.',
  },
];
