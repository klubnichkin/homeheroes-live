                  <div style="font-size:0.55rem;font-weight:700;color:#6a7a8e;margin-top:2px;letter-spacing:0.04em">SERVICE CALL</div>
                </div>
                <div style="background:#fff;border-radius:10px;padding:8px 12px;box-shadow:0 4px 16px rgba(10,20,40,0.2)">
