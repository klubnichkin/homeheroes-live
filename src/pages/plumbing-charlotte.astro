    <!-- ═══════════════════════════════════════════
         TRUST BAR
    ═══════════════════════════════════════════ -->
    <div class="bg-navy-section" style="border-top:2px solid #8a0e0e;padding:40px 24px">
      <div style="max-width:1280px;margin:0 auto">
        <div class="trust-grid">
          {[
            { icon:'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z', label:'NC Licensed Plumbers', sub:'Fully insured · Background checked' },
