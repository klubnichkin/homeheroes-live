            </div>

            <button id="plumb-submit" type="submit" class="btn-red" style="width:100%;padding:14px;font-size:0.97rem;border-radius:10px">
              Request Same-Day Plumbing →
            </button>
            <p style="font-size:0.69rem;color:#9aaabe;text-align:center;margin:0;font-weight:400">We respect your privacy. Your info is never sold or shared.</p>
          </form>

          <div id="plumb-success" style="display:none;padding:40px 32px;text-align:center">
            <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(180deg,#d42222,#8e1010);display:flex;align-items:center;justify-content:center;margin:0 auto 18px">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
            </div>
            <p style="font-size:1.05rem;font-weight:800;color:#060c19;margin:0 0 6px;letter-spacing:-0.01em">Request received.</p>
            <p style="font-size:0.88rem;color:#4a5e74;margin:0;font-weight:400">We'll call you shortly.</p>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />

  <script>
    const form = document.getElementById('plumbing-form') as HTMLFormElement | null;
    const success = document.getElementById('plumb-success');
    const btn = document.getElementById('plumb-submit') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!btn) return;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await res.json();
        if (data.success) {
          form.style.display = 'none';
          if (success) success.style.display = 'block';
        } else {
          btn.disabled = false;
          btn.textContent = 'Request Same-Day Plumbing →';
          alert('Something went wrong. Please call us directly.');
        }
      } catch {
        btn.disabled = false;
        btn.textContent = 'Request Same-Day Plumbing →';
        alert('Something went wrong. Please call us directly.');
      }
    });
  </script>
</body>
</html>
